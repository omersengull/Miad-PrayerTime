{
  "ayetler": [
    {
      "metin": "Yalancı ve günahkar perçeminden cehenneme sürükleriz",
      "kaynak": "Alak Suresi, 16. Ayet"
    },
    {
      "metin": "De ki: \"Koştuğunuz ortaklardan, önce yaratan, sonra bunu tekrar eden var mıdır?\" De ki: \"Allah önce yaratır, sonra bunu tekrar eder. Nasıl da döndürülürsünüz",
      "kaynak": "Yûnus Suresi, 34. Ayet"
    },
    {
      "metin": "Lut'a da hüküm ve ilim verdik; onu, çirkin işler işleyen kasabadan kurtardık. Doğrusu onlar yoldan çıkmış kötü bir milletti",
      "kaynak": "Enbiyâ Suresi, 74. Ayet"
    },
    {
      "metin": "Rahman ve Rahim olan Allah'ın adıyla",
      "kaynak": "Fâtiha Suresi, 1. Ayet"
    },
    {
      "metin": "İbrahim, babasına ve milletine: \"Nelere tapıyorsunuz?\" demişti",
      "kaynak": "Şuarâ Suresi, 70. Ayet"
    },
    {
      "metin": "Şüphesiz bunlarda Allah'ın kudretine işaret vardır, ama çoğu inanmazlar",
      "kaynak": "Şuarâ Suresi, 8. Ayet"
    },
    {
      "metin": "Hapse, onunla beraber, iki genç daha girdi. Biri, \"Rüyamda şaraplık üzüm sıktığımı gördüm\" dedi; diğeri \"Başımın üzerinde, kuşların yediği bir ekmek taşıdığımı gördüm\" dedi. \"Bize bunu yorumla; senin iyi bir kimse olduğunu görüyoruz",
      "kaynak": "Yûsuf Suresi, 36. Ayet"
    },
    {
      "metin": "Allah'a döneceğiniz ve sonra haksızlığa uğramadan herkesin kazancının kendisine eksiksiz verileceği günden korkunuz",
      "kaynak": "Bakara Suresi, 281. Ayet"
    },
    {
      "metin": "İkiyüzlüler, Allah'ın onların sırlarını ve gizli toplantılarını bildiğini, Allah'ın görünmeyenleri bilen olduğunu bilmiyorlar mıydı",
      "kaynak": "Tevbe Suresi, 78. Ayet"
    },
    {
      "metin": "Göklerde olanlar, yerde olanlar O'nundur. Doğrusu Allah müstağnidir, övülmeğe layık olandır",
      "kaynak": "Hac Suresi, 64. Ayet"
    },
    {
      "metin": "Eğer gerçek onların heveslerine uysaydı, gökler, yer ve onlarda bulananlar bozulup giderdi. Onlara, kendilerine öğüt veren bir şey getirdik; onlar ise öğütlerinden yüz çevirirler",
      "kaynak": "Mü'minûn Suresi, 71. Ayet"
    },
    {
      "metin": "Onların dediklerine sabret; güneşin doğmasından ve batmasından önce Rabbini hamd ile tesbih et; gece saatlerinde ve gündüzleri de tesbih et ki Rabbinin rızasına eresin",
      "kaynak": "Tâhâ Suresi, 130. Ayet"
    },
    {
      "metin": "Nasıl olabilir ki, size üstün gelselerdi ne bir yakınlık, ne de bir ahd gözetirlerdi. Kalpleriyle istemezlerken sizi ağızlarıyla hoşnut etmeye uğraşırlar; çokları fasıktırlar",
      "kaynak": "Tevbe Suresi, 8. Ayet"
    },
    {
      "metin": "Buyruğumuz gelince, Hud'u ve beraberindeki inananları, rahmetimizle kurtardık. Onları çetin bir azabdan koruduk",
      "kaynak": "Hûd Suresi, 58. Ayet"
    },
    {
      "metin": "İnkar edenleri ve zalimleri Allah şüphesiz bağışlamaz, onları içinde temelli ve ebediyyen kalacakları cehennem yolundan başka bir yola eriştirmez. Bu, Allah'a kolaydır",
      "kaynak": "Nisâ Suresi, 168. Ayet"
    },
    {
      "metin": "Geceyi gündüze, gündüzü geceye geçirirsin; ölüden diri, diriden ölü çıkarırsın; dilediğini hesapsız rızıklandırırsın",
      "kaynak": "Âl-i İmrân Suresi, 27. Ayet"
    },
    {
      "metin": "Kitap ehlinin çoğu, hak kendilerine apaçık belli olduktan sonra, içlerindeki çekememezlikten ötürü, sizi, inandıktan sonra küfre döndürmeyi isterler. Allah'ın emri gelene kadar onları affedin, geçin. Allah muhakkak her şeye Kadir'dir",
      "kaynak": "Bakara Suresi, 109. Ayet"
    },
    {
      "metin": "Harun: \"Ey Annemoğlu! Saçımdan sakalımdan tutma; doğrusu İsrailoğulları arasına ayrılık koydun, sözüme bakmadın demenden korktum\" dedi",
      "kaynak": "Tâhâ Suresi, 94. Ayet"
    },
    {
      "metin": "Başlarına kendi işlediklerinden ötürü bir musibet çattığında sana gelip: \"Biz, iyilik etmek ve uzlaştırmaktan başka bir şey istemedik\" diye de nasıl Allah'a yemin ederler",
      "kaynak": "Nisâ Suresi, 62. Ayet"
    },
    {
      "metin": "Hamd, Alemlerin Rabbi Allah'a mahsustur",
      "kaynak": "Fâtiha Suresi, 2. Ayet"
    },
    {
      "metin": "Rabbin'den sana vahyolunana uy, O'ndan başka tanrı yoktur, puta tapanlardan yüz çevir",
      "kaynak": "En'âm Suresi, 106. Ayet"
    },
    {
      "metin": "Şüphesiz Kuran Alemlerin Rabbinin indirmesidir",
      "kaynak": "Şuarâ Suresi, 192. Ayet"
    },
    {
      "metin": "Doğrusu Allah, inanıp yararlı iş işleyenleri, içlerinden ırmaklar akan cennetlere koyar. Orada altın bilezikler ve inciler takınırlar. Oradaki elbiseleri de ipektendir",
      "kaynak": "Hac Suresi, 23. Ayet"
    },
    {
      "metin": "Başına gelen sıkıntıdan sonra, ona bir nimet tattırırsak, \"Musibetler başımdan gitti\" der; doğrusu o, şımarıp böbürlenen biridir",
      "kaynak": "Hûd Suresi, 10. Ayet"
    },
    {
      "metin": "Onu işittiğiniz zaman, erkek kadın müminlerin, kendiliklerinden hüsnü zanda bulunup da: \"Bu apaçık bir iftiradır\" demeleri gerekmez miydi",
      "kaynak": "Nûr Suresi, 12. Ayet"
    },
    {
      "metin": "Sana vahyedilene uy; Allah hükmünü verene kadar sabret. O, hüküm verenlerin en iyisidir",
      "kaynak": "Yûnus Suresi, 109. Ayet"
    },
    {
      "metin": "İnkar eden kimseler ve ayetlerimizi yalan sayanlar cehennemlik olanlardır, onlar orada temelli kalacaklardır",
      "kaynak": "Bakara Suresi, 39. Ayet"
    },
    {
      "metin": "Biz onları yemek yemez birer ceset kılmadık ve onlar ölümsüz de değillerdi",
      "kaynak": "Enbiyâ Suresi, 8. Ayet"
    },
    {
      "metin": "Bunlar, yalnız Allah'ın gerçek olduğunu, ölüleri dirilttiğini, gücünün herşeye yettiğini, şüphe götürmeyen kıyamet saatinin geleceğini, Allah'ın kabirlerde olanı dirilteceğini gösterir",
      "kaynak": "Hac Suresi, 6. Ayet"
    },
    {
      "metin": "Rabbine suçlu olarak gelen bilsin ki, cehennem onun içindir. Orada ne ölür, ne yaşar",
      "kaynak": "Tâhâ Suresi, 74. Ayet"
    },
    {
      "metin": "Milletinin büyüklük taslayan ileri gelenleri, aralarından iman eden ve bu sebeple hor gördükleri kimselere, \"Salih'in Rabbi tarafından gönderildiğini sahiden biliyor musunuz?\" dediler, onlar da, \"Doğrusu biz onunla gönderilene inanıyoruz\" dediler",
      "kaynak": "A'râf Suresi, 75. Ayet"
    },
    {
      "metin": "Musa, milletine kızgın ve üzgün olarak döndü. \"Ey milletim! Rabbiniz size güzel bir vaadde bulunmadı mı? Uzun bir zaman mı geçti, yoksa Rabbinizin gazabına mı uğramak istediniz de bana verdiğiniz sözden caydınız?\" dedi",
      "kaynak": "Tâhâ Suresi, 86. Ayet"
    },
    {
      "metin": "Sonunda, karıncaların bulunduğu vadiye geldiklerinde bir dişi (kraliçe) karınca: \"Ey karıncalar! Yuvalarınıza girin, Süleyman'ın ordusu farkına varmadan sizi ezmesin\" dedi",
      "kaynak": "Neml Suresi, 18. Ayet"
    },
    {
      "metin": "Gerçeği batılın başına çarparız ve onun beynini parçalar; böylece batıl ortadan kalkar. Allah'a yakıştırdığınız vasıflardan ötürü yazıklar olsun size",
      "kaynak": "Enbiyâ Suresi, 18. Ayet"
    },
    {
      "metin": "De ki: \"Koştuğunuz ortaklardan gerçeğe eriştiren var mıdır?\" De ki: \"Ama Allah gerçeğe eriştirir. Gerçeğe eriştiren mi, yoksa, birisi götürmezse gidemeyen mi uyulmağa daha layıktır? Ne biçim hüküm veriyorsunuz",
      "kaynak": "Yûnus Suresi, 35. Ayet"
    },
    {
      "metin": "Musa! Seni milletinden daha çabuk gelmeye sevkeden nedir?\" dedik",
      "kaynak": "Tâhâ Suresi, 83. Ayet"
    },
    {
      "metin": "De ki: \"Gördünüz mü? Allah, işitmenizi, gözlerinizi alsa, kalblerinizi kapasa, Allah'tan başka hangi tanrı onu sizlere getirebilir?\" Ayetleri nasıl türlü türlü açıkladığımıza bir baksana, sonra da onlar yüz çevirirler",
      "kaynak": "En'âm Suresi, 46. Ayet"
    },
    {
      "metin": "Cahiliye devri hükmünü mü istiyorlar? Yakinen bilen bir millet için Allah'tan daha iyi hüküm veren kim vardır",
      "kaynak": "Mâide Suresi, 50. Ayet"
    },
    {
      "metin": "İbrahim, babası Azer'e, \"Putları tanrı olarak mı benimsiyorsun? Doğrusu ben seni ve milletini açık bir sapıklık içinde görüyorum\" demişti",
      "kaynak": "En'âm Suresi, 74. Ayet"
    },
    {
      "metin": "De ki, \"Eğer ahiret yurdu Allah katında başkalarına değil de yalnız size mahsus ise ve eğer doğru sözlü iseniz, ölümü dilesenize",
      "kaynak": "Bakara Suresi, 94. Ayet"
    },
    {
      "metin": "Sen ancak büyülenmişin birisin. Bizim gibi bir insandan başka bir şey değilsin. Doğrusu seni yalancılardan sanıyoruz. Eğer doğru sözlü isen göğün bir parçasını üstümüze düşür\" dediler",
      "kaynak": "Şuarâ Suresi, 187. Ayet"
    },
    {
      "metin": "(Muhammed'e) \"Yüzünü, doğruya yönelmiş olarak dine çevir, sakın ortak koşanlardan olma; sana fayda da zarar da veremeyecek, Allah'tan başkasına yalvarma; öyle yaparsan şüphesiz, zalimlerden olursun\" denildi",
      "kaynak": "Yûnus Suresi, 106. Ayet"
    },
    {
      "metin": "Senden önce de, kendilerine vahyettiğimiz adamlar gönderdik. Bilmiyorsanız kitablılara sorun",
      "kaynak": "Enbiyâ Suresi, 7. Ayet"
    },
    {
      "metin": "Zina eden erkek, ancak zina eden veya putperest bir kadınla evlenebilir. Zina eden kadınla da, ancak zina eden veya putperest olan bir erkek evlenebilir. Bu, müminlere yasak edilmiştir",
      "kaynak": "Nûr Suresi, 3. Ayet"
    },
    {
      "metin": "Ey inananlar! Rüku edin, secdeye varın, Rabbiniz'e kulluk edin, iyilik yapın ki saadete erişesiniz",
      "kaynak": "Hac Suresi, 77. Ayet"
    },
    {
      "metin": "Bir kent halkı inanmalı değil miydi ki, imanları kendilerine fayda versin! İşte Yunus'un milleti, inandığı zaman, dünya hayatında rezilliği gerektiren azabı onlardan kaldırdık ve onları bir süre daha bu dünyada geçindirdik",
      "kaynak": "Yûnus Suresi, 98. Ayet"
    },
    {
      "metin": "İşte Kuran'ı, Arapça okunmak üzere indirdik, onda tehditleri türlü türlü açıkladık ki belki sakınırlar yahut onlara ibret verir",
      "kaynak": "Tâhâ Suresi, 113. Ayet"
    },
    {
      "metin": "Sana uyan müminleri kanatların altına al",
      "kaynak": "Şuarâ Suresi, 215. Ayet"
    },
    {
      "metin": "Şeytanın kardeşleri onları azgınlığa sürüklerler ve bundan hiç geri durmazlar",
      "kaynak": "A'râf Suresi, 202. Ayet"
    },
    {
      "metin": "Zulmeden milletin kökü böylece kesildi. Hamd, Alemlerin Rabbi Allah'a mahsustur",
      "kaynak": "En'âm Suresi, 45. Ayet"
    },
    {
      "metin": "Yoksa Allah'ın bol nimetinden verdiği kimseleri mi çekemiyorlar? Oysa İbrahim ailesine kitap ve hikmet verdik, onlara büyük hükümranlık bahşettik",
      "kaynak": "Nisâ Suresi, 54. Ayet"
    },
    {
      "metin": "Dilerse sana, bunlardan daha iyi olan, içlerinden ırmaklar akan cennetler verebilen ve köşkler kurabilen Allah yücelerin yücesidir",
      "kaynak": "Furkân Suresi, 10. Ayet"
    },
    {
      "metin": "Rabbin dileseydi, yeryüzünde bulunanların hepsi inanırdı. Öyle iken insanları inanmaya sen mi zorlayacaksın",
      "kaynak": "Yûnus Suresi, 99. Ayet"
    },
    {
      "metin": "Firavun ve erkanının kendilerine fenalık yapmasından korktuklarından, milletinin bir kısım gençleri dışında, kimse Musa'ya inanmamıştı, çünkü Firavun o yerde hakimdi. O, gerçekten aşırı gidenlerdendi",
      "kaynak": "Yûnus Suresi, 83. Ayet"
    },
    {
      "metin": "Allah'a güvendik; Ey Rabbimiz! Zalim bir millet ile bizi sınama, rahmetinle bizi kafirlerden kurtar\" dediler",
      "kaynak": "Yûnus Suresi, 85. Ayet"
    },
    {
      "metin": "Seni yalancı sayıyorlarsa bil ki, onlardan önce Nuh milleti, Ad, Semud, İbrahim milleti, Lut milleti ve Medyen halkı da peygamberlerini yalancı saymış ve Musa da yalanlanmıştı. Ama Ben, kafirlere önce mehil verdim, sonra da onları yakalayıverdim; Beni tanımamak nasılmış görsünler",
      "kaynak": "Hac Suresi, 44. Ayet"
    },
    {
      "metin": "İsrailoğullarına sor; onlara apaçık nice ayetler verdik, Allah'ın nimetini, kendisine geldikten sonra kim değiştirirse, bilsin ki, Allah'ın cezası şüphesiz şiddetlidir",
      "kaynak": "Bakara Suresi, 211. Ayet"
    },
    {
      "metin": "Ey inananlar! Allah'a ve Peygambere karşı hainlik etmeyin, size güvenilen şeylere bile bile hıyanet etmiş olursunuz",
      "kaynak": "Enfâl Suresi, 27. Ayet"
    },
    {
      "metin": "Rablerinden kendilerine gelen her yeni ihtarı mutlaka, gönülleri gaflet içinde eğlenerek dinlerler. Zulmedenler, gizli toplantılarında: \"Bu zat, sizin gibi bir insandan başka bir şey midir? Siz, göz göre göre sihre mi uyarsınız?\" diye konuşurlar",
      "kaynak": "Enbiyâ Suresi, 3. Ayet"
    },
    {
      "metin": "Şöyle dediler: \"Bu ne biçim peygamber ki yemek yer, sokaklarda gezer? Ona, beraberinde bulunup uyaran bir melek indirilseydi ya! Yahut, kendisine bir hazine verilseydi, veya besleneceği bir bahçe olsaydı ya!\" Bu zalimler, inananlara: \"Siz sadece büyülenmiş bir adama uyuyorsunuz\" dediler",
      "kaynak": "Furkân Suresi, 7. Ayet"
    },
    {
      "metin": "Allah seni geri döndürüp, onlardan bir toplulukla karşılaştırdığı zaman, senden savaşa çıkmak için izin isterlerse, de ki: \"Benimle asla çıkamayacaksınız, benim yanımda hiçbir düşmanla savaşmıyacaksınız; çünkü baştan, oturup kalmaya razı oldunuz. Artık geri kalanlarla beraber oturun",
      "kaynak": "Tevbe Suresi, 83. Ayet"
    },
    {
      "metin": "Kuran okunduğu zaman ona kulak verin, dinleyin ki merhamet olunasınız",
      "kaynak": "A'râf Suresi, 204. Ayet"
    },
    {
      "metin": "Temelli kalacakları cennette diledikleri şeyleri bulurlar. Bu, Rabbinin yerine getirilmesi istenen bir vaadidir",
      "kaynak": "Furkân Suresi, 16. Ayet"
    },
    {
      "metin": "Bu kimseler, sözün güzelini işitecek duruma ulaştırılmışlar, övülmeğe layık olan Allah'ın yoluna eriştirilmişlerdir",
      "kaynak": "Hac Suresi, 24. Ayet"
    },
    {
      "metin": "İşte haddi aşanları, Rabbinin ayetlerine inanmayanları böylece cezalandıracağız. Hem, ahiretin azabı bu dünya azabından daha şiddetli ve daha devamlıdır",
      "kaynak": "Tâhâ Suresi, 127. Ayet"
    },
    {
      "metin": "Keza Hak yalnız Allah'tır; O'nu bırakıp taptıkları sadece batıldır. Doğrusu Allah yücedir büyüktür",
      "kaynak": "Hac Suresi, 62. Ayet"
    },
    {
      "metin": "Eğer Rabbinin verilmiş bir sözü ve tayin ettiği bir süre olmasaydı, hemen azaba uğrarlardı",
      "kaynak": "Tâhâ Suresi, 129. Ayet"
    },
    {
      "metin": "Allah'ın rahmetinden dolayı, sen onlara karşı yumuşak davrandın. Eğer kaba ve katı kalbli olsaydın, şüphesiz etrafından dağılır giderlerdi. Onları affet, onlara mağfiret dile, iş hakkında onlara danış, fakat karar verdin mi Allah'a güven, doğrusu Allah güvenenleri sever",
      "kaynak": "Âl-i İmrân Suresi, 159. Ayet"
    },
    {
      "metin": "Doğrusu ben yüzümü, gökleri ve yeri yaratana, doğruya yönelerek çevirdim, ben ortak koşanlardan değilim",
      "kaynak": "En'âm Suresi, 79. Ayet"
    },
    {
      "metin": "Putlara tapıyoruz, onlara bağlanıp duruyoruz\" demişlerdi",
      "kaynak": "Şuarâ Suresi, 71. Ayet"
    },
    {
      "metin": "Onlar için cehennemden bir yatak ve üstlerine de örtüler vardır. Zalimleri böyle cezalandırırız",
      "kaynak": "A'râf Suresi, 41. Ayet"
    },
    {
      "metin": "Güneşi ışıklı ve ayı nurlu yapan; yılların sayısını ve hesabı bilmeniz için, aya konak yerleri düzenleyen O'dur. Allah bunları ancak gerçeğe göre yaratmıştır; bilen millete ayetleri uzun uzadıya açıklıyor",
      "kaynak": "Yûnus Suresi, 5. Ayet"
    },
    {
      "metin": "Bunları ne ticaret ve ne de alışveriş Allah'ı anmaktan, namaz kılmaktan, zekat vermekten alıkoyar. Bunlar, gönüllerin ve gözlerin döneceği günden korkarlar",
      "kaynak": "Nûr Suresi, 37. Ayet"
    },
    {
      "metin": "Doğrusu inanıp sonra inkar edenleri, sonra inanıp tekrar inkar edenleri, sonra da inkarları artmış olanları Allah bağışlamaz; onları doğru yola eriştirmez",
      "kaynak": "Nisâ Suresi, 137. Ayet"
    },
    {
      "metin": "Allah bunu, ancak size müjde olsun ve böylece kalbleriniz yatışsın diye yapmıştır. İnkar edenlerin bir kısmını kesmek veya ümidsiz olarak geri dönecek şekilde bozguna uğratmak için gereken yardım, ancak Güçlü ve Hakim olan Allah katından olur",
      "kaynak": "Âl-i İmrân Suresi, 127. Ayet"
    },
    {
      "metin": "Süleyman Davud'a varis oldu: \"Ey insanlar! Bize kuş dili öğretildi ve bize herşeyden bolca verildi. Doğrusu bu apaçık bir lütuftur\" dedi",
      "kaynak": "Neml Suresi, 16. Ayet"
    },
    {
      "metin": "Birinize ölüm geldiği zaman, eğer mal bırakıyorsa, ana babaya, yakınlara, uygun bir tarzda vasiyet etmesi Allah'a karşı gelmekten sakınanlara bir borç olarak size farz kılındı",
      "kaynak": "Bakara Suresi, 180. Ayet"
    },
    {
      "metin": "Söylediğinizi yapamazlarsa, bilin ki o, ancak Allah'ın ilmiyle indirilmiştir. O'ndan başka tanrı yoktur, artık müslümansınız değil mi",
      "kaynak": "Hûd Suresi, 14. Ayet"
    },
    {
      "metin": "İnananlar, \"Sizinle beraber olduklarına bütün güçleriyle Allah'a yemin edenler bunlar mıdır?\" derler. Onların amelleri boşa gitmiş ve kaybeden kimseler olmuşlardır",
      "kaynak": "Mâide Suresi, 53. Ayet"
    },
    {
      "metin": "İnkar edenlerin işleri engin çöllerdeki serap gibidir. Susayan kimse onu su zanneder, fakat oraya geldiğinde hiçbir şey bulamaz. Orada Allah'ı bulur ve O da hesabını görür. Allah hesabı çabuk görendir",
      "kaynak": "Nûr Suresi, 39. Ayet"
    },
    {
      "metin": "Cömertçe verilmiş rızık ve mağfiret, inanan ve yararlı iş işleyenleredir",
      "kaynak": "Hac Suresi, 50. Ayet"
    },
    {
      "metin": "And olsun ki, onları hoşnut olacakları bir yere koyar. Şüphesiz Allah bilendir, Halim'dir",
      "kaynak": "Hac Suresi, 59. Ayet"
    },
    {
      "metin": "Suçluların yolu belli olsun diye, böylece ayetleri uzun uzun açıklarız",
      "kaynak": "En'âm Suresi, 55. Ayet"
    },
    {
      "metin": "Bu arada Firavun şehirlere, \"Doğrusu bunlar bizi öfkelendiren döküntü azınlıklardır; hepimiz tedbirli olmalıyız\" diyen münadiler gönderdi",
      "kaynak": "Şuarâ Suresi, 55. Ayet"
    },
    {
      "metin": "Çünkü benim dostum, Kitap'ı indiren Allah'tır. O, iyileri dost edinir",
      "kaynak": "A'râf Suresi, 196. Ayet"
    },
    {
      "metin": "Buna rağmen onu kesip devirdiler. O zaman Salih: \"Yurdunuzda üç gün daha kalın. Bu, yalanlanmayacak bir sözdür\" dedi",
      "kaynak": "Hûd Suresi, 65. Ayet"
    },
    {
      "metin": "Ancak Allah dilerse onu başınıza getirir, siz O'nu aciz bırakamazsınız. Allah sizi azdırmak isterse, ben size öğüt vermek istesem de faydası olmaz. O, sizin Rabbinizdir, O'na döndürüleceksiniz\" dedi",
      "kaynak": "Hûd Suresi, 34. Ayet"
    },
    {
      "metin": "Zina eden kadın ve erkeğin her birine yüzer değnek vurun. Allah'a ve ahiret gününe inanıyorsanız, Allah'ın dini konusunda o ikisine acımayın. Onların ceza görmesine, inananlardan bir topluluk da şahit olsun",
      "kaynak": "Nûr Suresi, 2. Ayet"
    },
    {
      "metin": "İnsanlar arasında, Allah'ın rızasını kazanmak için canını verenler vardır. Allah kullarına karşı şefkatlidir",
      "kaynak": "Bakara Suresi, 207. Ayet"
    },
    {
      "metin": "Kötülük işleyip ardından tevbe edenler ve inananlar bilsinler ki Rabbin, bu hareketlerinin ardından onları şüphesiz bağışlar ve merhamet eder",
      "kaynak": "A'râf Suresi, 153. Ayet"
    },
    {
      "metin": "Yok ettiğimiz kasaba halkının ahirette ceza görmek üzere Bize dönmemesi imkansızdır",
      "kaynak": "Enbiyâ Suresi, 95. Ayet"
    },
    {
      "metin": "Allah inananların dostudur, onları karanlıklardan aydınlığa çıkarır. İnkar edenlerin ise dostları tağuttur. Onları aydınlıktan karanlıklara sürüklerler. İşte onlar cehennemliklerdir, onlar orada temelli kalacaklardır",
      "kaynak": "Bakara Suresi, 257. Ayet"
    },
    {
      "metin": "İşte onlara, kazançlarından ötürü karşılık vardır. Allah hesabı çabuk görür",
      "kaynak": "Bakara Suresi, 202. Ayet"
    },
    {
      "metin": "İnkar edenler, ceza saati kendilerine ansızın gelene veya gecesi olmayan günün azabı çatana kadar Kuran'dan şüphe etmekte devam ederler",
      "kaynak": "Hac Suresi, 55. Ayet"
    },
    {
      "metin": "Yeryüzünde dolaşmıyorlar mı ki, orada olanları akledecek kalbleri, işitecek kulakları olsun. Ama yalnız gözler kör olmaz, fakat göğüslerde olan kalbler de körleşir",
      "kaynak": "Hac Suresi, 46. Ayet"
    },
    {
      "metin": "Onlar fena bir şey yaptıklarında veya kendilerine zulmettiklerinde Allah'ı anarlar, günahlarının bağışlanmasını dilerler. Günahları Allah'tan başka bağışlayan kim vardır? Onlar, yaptıklarında bile bile direnmezler",
      "kaynak": "Âl-i İmrân Suresi, 135. Ayet"
    },
    {
      "metin": "Koşup kaçmayın; size nimet verilen yere, yurdlarınıza dönün, elbette sorguya çekileceksiniz\" dedik",
      "kaynak": "Enbiyâ Suresi, 13. Ayet"
    },
    {
      "metin": "Ey Musa! Orada zorba bir millet vardır, onlar oradan çıkmadıkça biz oraya girmeyeceğiz, eğer çıkarlarsa, biz de gireriz\" demişlerdi",
      "kaynak": "Mâide Suresi, 22. Ayet"
    },
    {
      "metin": "De ki: \"Allah'tan başka, yalvardıklarınıza kulluk etmekten menolundum.\" \"Sizin heveslerinize uymayacağım, yoksa sapıtmış, doğru yolda gidenlerden olmamış olurum\" de",
      "kaynak": "En'âm Suresi, 56. Ayet"
    },
    {
      "metin": "O, geçmişlerini geleceklerini bilir. Bütün işler Allah'a döner",
      "kaynak": "Hac Suresi, 76. Ayet"
    },
    {
      "metin": "De ki: \"Kara ve denizin karanlıklarından sizi kim kurtarır? Bundan bizi kurtarırsan şükredenlerden olacağız diye O'na gizli gizli yalvarır yakarırsınız",
      "kaynak": "En'âm Suresi, 63. Ayet"
    },
    {
      "metin": "İnananlar toptan savaşa çıkmamalıdır. Her topluluktan bir taifenin dini iyi öğrenmek ve milletlerini geri döndüklerinde uyarmak üzere geri kalmaları gerekli olmaz mı? Ki böylece belki yanlış hareketlerden çekinirler",
      "kaynak": "Tevbe Suresi, 122. Ayet"
    },
    {
      "metin": "Rabbin şüphesiz güçlüdür, merhametlidir",
      "kaynak": "Şuarâ Suresi, 191. Ayet"
    },
    {
      "metin": "Allah'ın azabının şiddetli olduğunu ve Allah'ın Bağışlayan, merhamet eden olduğunu bilin",
      "kaynak": "Mâide Suresi, 98. Ayet"
    },
    {
      "metin": "Yaptıklarının cezası olarak, bundan böyle az gülsünler, çok ağlasınlar",
      "kaynak": "Tevbe Suresi, 82. Ayet"
    },
    {
      "metin": "Allah'ın yüksek tutulmasına ve içlerinde adının anılmasına izin verdiği evlerde, insanlar sabah akşam O'nu tesbih ederler",
      "kaynak": "Nûr Suresi, 36. Ayet"
    },
    {
      "metin": "Eğlenme dileseydik, bunu yapacak olsaydık, şanımıza uygun şekilde yapardık; ama yapmayız",
      "kaynak": "Enbiyâ Suresi, 17. Ayet"
    },
    {
      "metin": "Allah, onları işlediklerinin en güzeliyle mükafatlandırır ve lütfundan onlara fazlasıyla verir. Allah dilediğini hesapsız şekilde rızıklandırır",
      "kaynak": "Nûr Suresi, 38. Ayet"
    },
    {
      "metin": "Yahudi veya Hıristiyan olun ki doğru yolu bulasınız\" dediler. \"Doğruya yönelmiş olan ve Allah'a eş koşanlardan olmayan İbrahim'in dinine uyarız\" de",
      "kaynak": "Bakara Suresi, 135. Ayet"
    },
    {
      "metin": "Kıyamet günü doğru teraziler kurarız; hiçbir kimse hiçbir haksızlığa uğratılmaz. Hardal tanesi kadar olsa bile yapılanı ortaya koyarız. Hesap gören olarak Biz yeteriz",
      "kaynak": "Enbiyâ Suresi, 47. Ayet"
    },
    {
      "metin": "Savaştan geri kalanların bir kısmının işi de Allah'ın buyruğuna kalmıştır. Allah onlara ya azabeder, ya da tevbelerini kabul eder. O bilendir, hakimdir",
      "kaynak": "Tevbe Suresi, 106. Ayet"
    },
    {
      "metin": "O zaman onlara kendi katımızdan büyük bir ecir verir ve onları doğru yola eriştirirdik",
      "kaynak": "Nisâ Suresi, 68. Ayet"
    },
    {
      "metin": "Allah bunu ancak bir müjde olması ve kalblerinizin yatışması için yapmıştı. Yardım ancak Allah katındandır. Doğrusu Allah güçlüdür, hakimdir",
      "kaynak": "Enfâl Suresi, 10. Ayet"
    },
    {
      "metin": "Kadınları bırakıp, erkeklere mi yaklaşıyorsunuz; evet, siz cahil bir milletsiniz",
      "kaynak": "Neml Suresi, 55. Ayet"
    },
    {
      "metin": "Allah oğul edindi\" dediler; haşa, oysa, göklerde ve yerde olanlar O'nundur. Hepsi O'na boyun eğmişlerdir",
      "kaynak": "Bakara Suresi, 116. Ayet"
    },
    {
      "metin": "Belki doğru yola dönerler diye ayetleri böylece uzun uzadıya açıklıyoruz",
      "kaynak": "A'râf Suresi, 174. Ayet"
    },
    {
      "metin": "Peygamberin görevi sadece tebliğ etmektir. Allah, sizin açıkladıklarınızı da gizlediklerinizi de bilir",
      "kaynak": "Mâide Suresi, 99. Ayet"
    },
    {
      "metin": "Allah'a karşı yalan uyduran veya ayetlerini yalan sayandan daha zalim kim olabilir? Suçlular elbette saadete erişemezler",
      "kaynak": "Yûnus Suresi, 17. Ayet"
    },
    {
      "metin": "Sabır ve namazla Allah'a sığınıp yardım isteyin; Rablerine kavuşacaklarını ve Ona döneceklerini umanlar ve huşu duyanlardan başkasına namaz elbette ağır gelir",
      "kaynak": "Bakara Suresi, 46. Ayet"
    },
    {
      "metin": "Esirler sana hıyanet etmek isterlerse, bilsinler ki esasen daha önce de Allah'a hıyanet etmişlerdi, Allah bundan ötürü onları yenmen için sana imkan verdi. Allah Bilen'dir, Hakim'dir",
      "kaynak": "Enfâl Suresi, 71. Ayet"
    },
    {
      "metin": "İnkar edenler, ayetlerimizi yalan sayan kimseler, işte onlar için hakir düşüren azap vardır",
      "kaynak": "Hac Suresi, 57. Ayet"
    },
    {
      "metin": "De ki: \"Gökten ve yerden size rızık veren kimdir? Kulak ve gözlerin sahibi kimdir? Diriyi ölüden çıkaran, ölüyü de diriden çıkaran kimdir? Her işi düzenleyen kimdir?\" Onlar: \"Allah'tır! \" diyecekler. \"O halde O'na karşı gelmekten sakınmaz mısınız?\" de",
      "kaynak": "Yûnus Suresi, 31. Ayet"
    },
    {
      "metin": "Rabbiniz'den refah istemenizde bir engel yoktur. Arafat'tan indiğinizde, Allah'ı Meşari Haram'da anın; O'nu, size gösterdiği şekilde zikredin. Nitekim siz önceleri hiç şüphesiz sapıklardandınız",
      "kaynak": "Bakara Suresi, 198. Ayet"
    },
    {
      "metin": "Onlara azabedersen, doğrusu onlar Senin kullarındır; onları bağışlarsan, Güçlü olan, Hakim olan şüphesiz ancak Sensin",
      "kaynak": "Mâide Suresi, 118. Ayet"
    },
    {
      "metin": "Musa, asasını yere atar atmaz apaçık bir yılan (ejderha) oluverdi; elini çıkardı, bakanlar bembeyaz olduğunu gördüler",
      "kaynak": "A'râf Suresi, 108. Ayet"
    },
    {
      "metin": "O gün, zalim kimse ellerini ısırıp: \"Keşke Peygamberle beraber bir yol tutsaydım, vay başıma gelene; keşke falancayı dost edinmeseydim. And olsun ki beni, bana gelen Kuran'dan o saptırdı. Şeytan insanı yalnız ve yardımcısız bırakıyor\" der",
      "kaynak": "Furkân Suresi, 28. Ayet"
    },
    {
      "metin": "Göklerde ve yerde ne varsa O'nundur. Katında olanlar O'na kulluk etmekten çekinmezler ve usanmazlar",
      "kaynak": "Enbiyâ Suresi, 19. Ayet"
    },
    {
      "metin": "Nuh: \"Ey milletim! Rabbimin katından bir delilim bulunsa ve bana yine katından bir rahmet vermiş de bunlar sizden gizlenmiş olsa, söyleyin bana, hoşlanmadığınız halde zorla sizi bunlara mecbur mu ederiz?\" dedi",
      "kaynak": "Hûd Suresi, 28. Ayet"
    },
    {
      "metin": "Sana bir misal vermezler ki, Biz onun gerçeğini ve en iyi anlaşılanını sana vermemiş olalım",
      "kaynak": "Furkân Suresi, 33. Ayet"
    },
    {
      "metin": "Allah'ın size nimet ve rahmeti bulunmasa ve Allah tevbeleri kabul eden ve Hakim olmasaydı suçlunun hemen cezasını verirdi",
      "kaynak": "Nûr Suresi, 10. Ayet"
    },
    {
      "metin": "Orada putlarıyla çekişerek: \"Vallahi biz apaçık bir sapıklıkta idik; çünkü biz sizi Alemlerin Rabbine eşit tutmuştuk; bizi saptıranlar ancak suçlulardır; şimdi şefaatçimiz, yakın bir dostumuz yoktur; keşke geriye bir dönüşümüz olsa da inananlardan olsak\" derler",
      "kaynak": "Şuarâ Suresi, 98. Ayet"
    },
    {
      "metin": "De ki: \"göklerde ve yerde olanlar kimindir?\", \"Allah'ındır\" de. O, rahmet etmeyi kendi üzerine almıştır; and olsun ki, sizi vukuu şüphe götürmeyen kıyamet gününde toplayacaktır. Kendilerine yazık ettiler; çünkü onlar inanmazlar",
      "kaynak": "En'âm Suresi, 12. Ayet"
    },
    {
      "metin": "O gün, zalim kimse ellerini ısırıp: \"Keşke Peygamberle beraber bir yol tutsaydım, vay başıma gelene; keşke falancayı dost edinmeseydim. And olsun ki beni, bana gelen Kuran'dan o saptırdı. Şeytan insanı yalnız ve yardımcısız bırakıyor\" der",
      "kaynak": "Furkân Suresi, 29. Ayet"
    },
    {
      "metin": "Onlara: \"Şu şehirde oturun, dilediğiniz gibi yiyip için, \"affet!\" deyin ve secde ederek kapısından girin; Biz de yanılmalarınızı bağışlarız. İyi davrananlara daha da artıracağız\" denmişti",
      "kaynak": "A'râf Suresi, 161. Ayet"
    },
    {
      "metin": "Ey Adem! Doğrusu bu, senin ve eşinin düşmanıdır. Sakın sizi cennetten çıkarmasın, yoksa bedbaht olursun. Doğrusu cennette ne acıkırsın, ne de çıplak kalırsın; orada ne susarsın ne de güneşin sıcağında kalırsın\" dedik",
      "kaynak": "Tâhâ Suresi, 117. Ayet"
    },
    {
      "metin": "Babalarımızı onlara tapar bulduk\" demişlerdi",
      "kaynak": "Enbiyâ Suresi, 53. Ayet"
    },
    {
      "metin": "İnkar edenler, kendilerine vermiş olduğumuz mühletin sakın kendileri için hayırlı olduğunu sanmasınlar. Biz onlara ancak, günahları çoğalsın diye mühlet veriyoruz. Küçültücü azab onlaradır",
      "kaynak": "Âl-i İmrân Suresi, 178. Ayet"
    },
    {
      "metin": "Yeryüzünde yaşayan bütün canlıların rızkı ancak Allah'a aittir. O, canlıları babaların sulbünde kararlaşmış ve anaların rahminde kararlaşmakta iken de bilir. Her şey apaçık bir Kitaptadır",
      "kaynak": "Hûd Suresi, 6. Ayet"
    },
    {
      "metin": "Kötü kadınlar kötü erkeklere, kötü erkekler kötü kadınlara yakışırlar. İyi kadınlar iyi erkeklere, iyi erkekler de iyi kadınlara yakışırlar. Bunlar, onların söylediklerinden uzaktırlar. İşte bunlara mağfiret ve cömertçe verilmiş rızık vardır",
      "kaynak": "Nûr Suresi, 26. Ayet"
    },
    {
      "metin": "Bu, onların: \"Bize ateş sadece sayılı birkaç gün değecektir\" demelerindendir. Uydurup durdukları şeyler, onları dinlerinde yanıltmıştır",
      "kaynak": "Âl-i İmrân Suresi, 24. Ayet"
    },
    {
      "metin": "Onlar, azgınlar ve İblis'in adamları, hepsi, tepetakla oraya atılırlar",
      "kaynak": "Şuarâ Suresi, 94. Ayet"
    },
    {
      "metin": "Namazı kıldıktan başka, Allah'ı ayakta iken, otururken, yan yatarken de anın. Emniyete kavuştuğunuzda, namazı gereğince kılın. Namaz şüphesiz, inananlara belirli vakitlerde farz kılınmıştır",
      "kaynak": "Nisâ Suresi, 103. Ayet"
    },
    {
      "metin": "Bu, onların Allah'a ve Peygamberine karşı koymalarındandır. Kim Allah'a ve peygamberine karşı koyarsa, bilsin ki, Allah'ın cezası şiddetlidir",
      "kaynak": "Enfâl Suresi, 13. Ayet"
    },
    {
      "metin": "Senden önce gönderdiğimiz her peygambere: \"Benden başka tanrı yoktur, Bana kulluk edin\" diye vahyetmişizdir",
      "kaynak": "Enbiyâ Suresi, 25. Ayet"
    },
    {
      "metin": "Sana, ganimetlere dair soru sorarlar, de ki: Ganimetler Allah'ın ve Peygamberindir. İnanıyorsanız Allah'tan sakının, aranızdaki münasebetleri düzeltin, Allah'a ve Peygamberine itaat edin",
      "kaynak": "Enfâl Suresi, 1. Ayet"
    },
    {
      "metin": "Musa milletine: \"Allah'tan yardım dileyin ve sabredin; yeryüzü şüphesiz Allah'ındır, kullarından dilediğini ona mirasçı kılar; sonuç Allah'a karşı gelmekten sakınanlarındır\" dedi",
      "kaynak": "A'râf Suresi, 128. Ayet"
    },
    {
      "metin": "Sonra, insanların toplu olarak akın ettiği yerden, siz de akın edin. Allah'tan mağfiret dileyin. Allah bağışlar ve merhamet eder",
      "kaynak": "Bakara Suresi, 199. Ayet"
    },
    {
      "metin": "Musa: \"Hayır; Rabbim benimle beraberdir, bana elbette yol gösterecektir\" dedi",
      "kaynak": "Şuarâ Suresi, 62. Ayet"
    },
    {
      "metin": "Onlarla Allah alay eder ve taşkınlıkları içinde bocalar durumda bırakır",
      "kaynak": "Bakara Suresi, 15. Ayet"
    },
    {
      "metin": "Suçluların kalblerine Kuran'ı böylece sokarız da, can yakıcı azabı görmedikçe ona inanmazlar. Bu azap onlara haberleri olmadan geliverecektir",
      "kaynak": "Şuarâ Suresi, 202. Ayet"
    },
    {
      "metin": "Allah, Kitap verilenlerden, onu insanlara açıklayacaksınız ve gizlemeyeceksiniz, diye ahid almıştı. Onlar ise, onu arkalarına atıp az bir değere değiştiler. Alış verişleri ne kötüdür",
      "kaynak": "Âl-i İmrân Suresi, 187. Ayet"
    },
    {
      "metin": "Ta, Sin, Bunlar Kuran'ın, Kitab-ı Mübin'in ayetleridir",
      "kaynak": "Neml Suresi, 1. Ayet"
    },
    {
      "metin": "Hem burada ve hem kıyamet gününde lanete uğratılırlar. Bu ne kötü bir bağıştır",
      "kaynak": "Hûd Suresi, 99. Ayet"
    },
    {
      "metin": "İşte kurbanlık deve ve sığırları Allah'ın size olan nişanelerinden kıldık. Onlarda sizin için hayır vardır. Bağlı halde keserken üzerlerine Allah'ın adını anın. Yan üstü düşüp ölünce onlardan yiyin, isteyene de istemeyene de verin. Şükredersiniz diye onları böylece sizin buyruğunuza verdik",
      "kaynak": "Hac Suresi, 36. Ayet"
    },
    {
      "metin": "Buyruğumuz gelince oraların altını üstüne getirdik; üzerine Rabbinin katından, işaretli olarak yığın yığın sert taş yağdırdık. Bunlar zalimlerden hiçbir zaman uzak olmayacaktır",
      "kaynak": "Hûd Suresi, 83. Ayet"
    },
    {
      "metin": "Eyyub da: \"Başıma bir bela geldi, (Sana sığındım), Sen merhametlilerin merhametlisisin\" diye Rabbine nida etmişti",
      "kaynak": "Enbiyâ Suresi, 83. Ayet"
    },
    {
      "metin": "O gün, gök beyaz bulutlar halinde parçalanacak ve melekler bölük bölük indirilecektir",
      "kaynak": "Furkân Suresi, 25. Ayet"
    },
    {
      "metin": "Yeri düzleyen, orada dağlar, nehirler var eden, her türlü üründen çift çift yetiştiren, gündüzü geceyle bürüyen de O'dur. Doğrusu bunlarda, düşünen kimseler için ibretler vardır",
      "kaynak": "Ra'd Suresi, 3. Ayet"
    },
    {
      "metin": "Elif, Lam, Ra; Bu, Allah'ın izniyle, insanları karanlıklardan aydınlığa, güçlü ve övülmeğe layık, göklerde ve yerde olanların sahibi Allah'ın yoluna çıkarman için, sana indirdiğimiz Kitaptır. Uğrayacakları çetin azabdan dolayı vay kafirlerin haline",
      "kaynak": "İbrâhîm Suresi, 1. Ayet"
    },
    {
      "metin": "De ki: \"Herkes gözlemektedir, siz de gözleyin. Şüphesiz düz yolun sahiplerinin kimler olduğunu ve kimlerin doğru yolda bulunduğunu bileceksiniz",
      "kaynak": "Tâhâ Suresi, 135. Ayet"
    },
    {
      "metin": "Doğru yola gidesiniz diye Musa'ya hakkı batıldan ayıran Kitabı vermiştik",
      "kaynak": "Bakara Suresi, 53. Ayet"
    },
    {
      "metin": "Eğer Rabbin dileseydi insanları tek bir ümmet kılardı. Fakat, Rabbinin merhamet ettikleri bir yana, hala ayrılıktadırlar, esasen onları bunun için yaratmıştır. Rabbinin \"And olsun ki cehennemi hep insan ve cin ile dolduracağım\" sözü yerine gelmiştir",
      "kaynak": "Hûd Suresi, 118. Ayet"
    },
    {
      "metin": "Yeminlerini bozan, Peygamberi sürgüne göndermeye azmeden bir toplumla savaşmanız gerekmez mi ki, önce onlar başlamışlardır? Onlardan korkar mısınız? Eğer inanıyorsanız bilin ki asıl korkmanız gereken Allah'tır",
      "kaynak": "Tevbe Suresi, 13. Ayet"
    },
    {
      "metin": "İbrahim bunu oğullarına vasiyet etti. Yakub da: \"Oğullarım! Allah dini size seçti, siz de ancak O'na teslim olmuş olarak can verin\" dedi",
      "kaynak": "Bakara Suresi, 132. Ayet"
    },
    {
      "metin": "Senden, başlarına acele azap getirmeni istiyorlar. Allah sözünden asla caymayacaktır. Rabbinin katında bir gün, saydıklarınızdan bin yıl gibidir",
      "kaynak": "Hac Suresi, 47. Ayet"
    },
    {
      "metin": "Allah'ın çocuk edindiğine dair ne kendilerinin ve ne de babalarının bir bilgisi vardır. Ağızlarından çıkan söz ne büyük iftiradır. Onlar yalnız ve yalnız yalan söylerler",
      "kaynak": "Kehf Suresi, 5. Ayet"
    },
    {
      "metin": "İşte bunlarin kalblerinde olanı Allah bilir. Onlardan yüz çevir, onlara öğüt ver, kendilerine tesirli sözler söyle",
      "kaynak": "Nisâ Suresi, 63. Ayet"
    },
    {
      "metin": "Dünya hayatında, çalışmaları boşa gitmiştir, oysa onlar güzel iş yaptıklarını sanıyorlardı",
      "kaynak": "Kehf Suresi, 104. Ayet"
    },
    {
      "metin": "Amel defteri ortaya konunca, suçluların, onda yazılı olanlardan korktuklarını görürsün, \"Vah bize, eyvah bize! Bu defter nasıl olmuş da küçük büyük bir şey bırakmadan hepsini saymış!\" derler. İşlediklerini hazır bulurlar. Rabbin kimseye haksızlık etmez",
      "kaynak": "Kehf Suresi, 49. Ayet"
    },
    {
      "metin": "Güçsüzlere, hastalara ve sarfedecek bir şeyi bulunmayanlara, Allah ve Peygamberine bağlı kaldıkları müddetçe sorumluluk yoktur. İyi davrananlara sorumluluk olmaz. Allah bağışlayandır, merhamet edendir",
      "kaynak": "Tevbe Suresi, 91. Ayet"
    },
    {
      "metin": "Bunu yapmayışı ancak Rabbinin sana merhamet etmesindendir. Çünkü O'nun sana olan nimeti büyüktür",
      "kaynak": "İsrâ Suresi, 87. Ayet"
    },
    {
      "metin": "Onlara: \"Siz onlardan ve Allah'tan başka taptıklarından ayrıldınız, bunun için mağaraya girin ki, Rabbiniz size rahmetini yaysın ve size işinizde kolaylık göstersin\" denildi",
      "kaynak": "Kehf Suresi, 16. Ayet"
    },
    {
      "metin": "Allah'ın Peygamberinin hilafına geri kalanlar, oturup kalmalarına sevindiler. Allah yolunda mallariyle ve canlariyle cihat hoşlarına gitmedi. \"Sıcakta savaşa çıkmayın\" dediler. De ki: \"Cehennem ateşi daha sıcaktır.\" Keşke bilseydiler",
      "kaynak": "Tevbe Suresi, 81. Ayet"
    },
    {
      "metin": "Doğrusu, inananlar ve yahudiler, sabiiler, hıristiyanlar, mecusiler, ortak koşanlar arasında, kıyamet günü Allah kesin hüküm verecektir. Doğrusu Allah herşeye şahiddir",
      "kaynak": "Hac Suresi, 17. Ayet"
    },
    {
      "metin": "Gecede ve gündüzde bulunan O'nundur. O işitendir, Bilen'dir",
      "kaynak": "En'âm Suresi, 13. Ayet"
    },
    {
      "metin": "Rabbiniz, gökleri ve yeri altı günde yaratan ve sonra arşa hükmeden, gündüzü durmadan kovalayan gece ile bürüyen; güneşi, ayı, yıldızları, hepsini buyruğuna baş eğdirerek var eden Allah'tır. Bilin ki yaratma da emir de O'nun hakkıdır. Alemlerin Rabbiolan Allah Yüce'dir",
      "kaynak": "A'râf Suresi, 54. Ayet"
    },
    {
      "metin": "De ki: \"Mülkün sahibi olan Allah'ım! Mülkü dilediğine verirsin; dilediğinden çekip alırsın; dilediğini aziz kılar, dilediğini alçaltırsın; iyilik elindedir. Doğrusu Sen, her şeye Kadir'sin",
      "kaynak": "Âl-i İmrân Suresi, 26. Ayet"
    },
    {
      "metin": "Dalgıçlık yapan ve bundan başka işler de gören şeytanlardan da onun buyruğu altına verdik. Onların hepsini gözetiyorduk",
      "kaynak": "Enbiyâ Suresi, 82. Ayet"
    },
    {
      "metin": "Hayır; sadece O'na yalvarırsınız; dilerse yalvardığınız şeyi giderir, siz de O'na koştuğunuz ortakları unutursunuz",
      "kaynak": "En'âm Suresi, 41. Ayet"
    },
    {
      "metin": "Musa: \"Onlar ardımdadır, Rabbim! Hoşnut olman için Sana acele geldim\" dedi",
      "kaynak": "Tâhâ Suresi, 84. Ayet"
    },
    {
      "metin": "Bir fitne kopmayacağını sandılar, körleştiler, sağırlaştılar; sonra Allah tevbelerini kabul etti, yine de çoğu körleştiler ve sağırlaştılar. Allah, işlediklerini görür",
      "kaynak": "Mâide Suresi, 71. Ayet"
    },
    {
      "metin": "Haksızlığa uğratılarak kendilerine savaş açılan kimselerin karşı koyup savaşmasına izin verilmiştir. Allah onlara yardım etmeğe elbette Kadir'dir",
      "kaynak": "Hac Suresi, 39. Ayet"
    },
    {
      "metin": "Eğer yüz çevirirlerse Allah'ın sizin dostunuz olduğunu bilin; O ne güzel dost, ne güzel yardımcıdır",
      "kaynak": "Enfâl Suresi, 40. Ayet"
    },
    {
      "metin": "Doğrusu onlar vahyi dinlemekten uzak tutulmuşlardır",
      "kaynak": "Şuarâ Suresi, 212. Ayet"
    },
    {
      "metin": "Orada onlara ah etmek vardır; birşey de işitemezler",
      "kaynak": "Enbiyâ Suresi, 100. Ayet"
    },
    {
      "metin": "Bunun üzerine Biz Musa'ya: \"Değneğinle denize vur\" diye vahyettik. Hemen deniz ikiye ayrıldı, her parçası yüce bir dağ gibiydi",
      "kaynak": "Şuarâ Suresi, 63. Ayet"
    },
    {
      "metin": "Şükreder ve inanırsanız, Allah size niçin azabetsin? Allah şükrün karşılığını verir ve bilir",
      "kaynak": "Nisâ Suresi, 147. Ayet"
    },
    {
      "metin": "Milletinin cevabı sadece, \"Onları kasabanızdan çıkarın, güya onlar temiz kalmaya uğraşan insanlarmış\" demek oldu",
      "kaynak": "A'râf Suresi, 82. Ayet"
    },
    {
      "metin": "Sen, Kitap verilenlere her türlü delili getirsen, yine de kıblene uymazlar; sen de onların kıblesine uyacak değilsin. Onlar birbirlerinin kıblesine de uymazlar. And olsun ki, eğer sana gelen ilimden sonra onların heveslerine uyarsan, şüphesiz o zaman zulmedenlerden olursun",
      "kaynak": "Bakara Suresi, 145. Ayet"
    },
    {
      "metin": "Onlar: \"Ey kendisine Kitap indirilen kimse! Sen mutlaka delisin. Doğrulardan isen melekleri bize getirsene\" dediler",
      "kaynak": "Hicr Suresi, 6. Ayet"
    },
    {
      "metin": "Mağaranın içinde onları yıllarca uyuttuk; sonra, iki taraftan hangisinin bekledikleri sonucu iyi hesaplamış olduğunu belirtmek için onları uyandırdık",
      "kaynak": "Kehf Suresi, 12. Ayet"
    },
    {
      "metin": "And olsun ki, üstünüzde yedi tabaka yarattık. Biz, yarattığımızdan habersiz değiliz",
      "kaynak": "Mü'minûn Suresi, 17. Ayet"
    },
    {
      "metin": "Tur dağını, gölgelik gibi onların üzerlerine yükseltmiştik, onlar tepelerine düşeceğini sanmışlardı. Onlara: \"Size verdiğimiz Kitap'a sıkıca sarılın, içinde olanı düşünün ki sakınanlardan olasınız\" demiştik",
      "kaynak": "A'râf Suresi, 171. Ayet"
    },
    {
      "metin": "Salih de onlardan yüz çevirdi ve \"Ey milletim! And olsun ki ben size Rabbimin sözünü bildirmiş ve öğüt vermiştim; fakat siz öğüt verenleri sevmiyorsunuz\" dedi",
      "kaynak": "A'râf Suresi, 79. Ayet"
    },
    {
      "metin": "De ki: \"Allah'ın azabı size ansızın veya açıkça gelirse, zalimlerden başkası mı yok olur? Bana bildirin",
      "kaynak": "En'âm Suresi, 47. Ayet"
    },
    {
      "metin": "Eğer Rabbin dileseydi insanları tek bir ümmet kılardı. Fakat, Rabbinin merhamet ettikleri bir yana, hala ayrılıktadırlar, esasen onları bunun için yaratmıştır. Rabbinin \"And olsun ki cehennemi hep insan ve cin ile dolduracağım\" sözü yerine gelmiştir",
      "kaynak": "Hûd Suresi, 119. Ayet"
    },
    {
      "metin": "Dört şahit getirmeleri gerekmez miydi? İşte bunlar, şahit getirmedikçe Allah katında yalancı olanlardır",
      "kaynak": "Nûr Suresi, 13. Ayet"
    },
    {
      "metin": "İbrahim ve İsmail, Kabenin temellerini yükseltiyordu: \"Rabbimiz! Yaptığımızı kabul buyur. Şüphesiz ki, Sen hem işitir hem bilirsin",
      "kaynak": "Bakara Suresi, 127. Ayet"
    },
    {
      "metin": "Oradan uzaklaştıklarında Musa, yanındaki gence: \"Azığımızı çıkar, and olsun bu yolculuğumuzda yorgun düştük\" dedi",
      "kaynak": "Kehf Suresi, 62. Ayet"
    },
    {
      "metin": "Bunun üzerine geride kalan yaşlı bir kadın dışında, onu ve ailesini, hepsini kurtardık",
      "kaynak": "Şuarâ Suresi, 171. Ayet"
    },
    {
      "metin": "Allah sizin tevbenizi kabul etmek ister, şehvetlerine uyanlar ise sizin büyük bir sapıklığa girmenizi isterler",
      "kaynak": "Nisâ Suresi, 27. Ayet"
    },
    {
      "metin": "Böyledir; Allah geceyi gündüze katar, gündüzü de geceye katar ve Allah şüphesiz işitir ve görür",
      "kaynak": "Hac Suresi, 61. Ayet"
    },
    {
      "metin": "Ey İnananlar! Gıyabında Kendisinden, kimin korktuğunu ortaya koymak için, (ihramlıyken) elinizin ve mızraklarınızın ulaştığı avdan bir şeyle Allah and olsun ki sizi dener. Bundan sonra kim haddi aşarsa ona elem verici azab vardır",
      "kaynak": "Mâide Suresi, 94. Ayet"
    },
    {
      "metin": "Bu sınırları aşmak isteyenler, işte bunlar aşırı gidenlerdir",
      "kaynak": "Mü'minûn Suresi, 7. Ayet"
    },
    {
      "metin": "Kendilerine edilen yasakları aşınca, onlara: \"Aşağılık birer maymun olun\" dedik",
      "kaynak": "A'râf Suresi, 166. Ayet"
    },
    {
      "metin": "Ölü idiniz sizleri diriltti, sonra öldürecek sonra tekrar diriltecek ve sonunda O'na döneceksiniz; öyleyken Allah'ı nasıl inkar edersiniz",
      "kaynak": "Bakara Suresi, 28. Ayet"
    },
    {
      "metin": "Onlara ayetlerimiz apaçık olarak okunduğu zaman, inkar edenlerin yüzlerinden inkarlarını anlarsın. Nerdeyse, kendilerine ayetlerimizi okuyanlara saldıracaklar. De ki: \"Size bundan daha fenasını haber vereyim mi? Allah'ın inkarcılara vadettiği ateş! Ne kötü bir dönüştür",
      "kaynak": "Hac Suresi, 72. Ayet"
    },
    {
      "metin": "Zarar vermek, inkar etmek, müminlerin arasını ayırmak, Allah ve Peygamber'ine karşı savaşanlara daha önceden gözcülük yapmak üzere bir mescid kurup: \"Biz sadece iyilik yapmak istedik\" diye yemin edenlerin yalancı olduklarına şüphesiz ki Allah şahiddir",
      "kaynak": "Tevbe Suresi, 107. Ayet"
    },
    {
      "metin": "İçlerinden birine, \"İnsanları uyar ve inananlara, Rableri katında yüksek makamlar olduğunu müjdele\" diye vahyetmemiz, insanların tuhafına mı gitti ki, kafirler: \"Bu apaçık bir büyücüdür\" dediler",
      "kaynak": "Yûnus Suresi, 2. Ayet"
    },
    {
      "metin": "Sana dağları sorarlar; de ki: \"Rabbim onları ufalayıp savuracak, yerlerini düz, kuru bir toprak haline getirecek; orada ne çukur, ne tümsek göreceksin. O gün, hiçbir tarafa sapmadan bir davetçiye uyarlar. Sesler Rahman'ın heybetinden kısılmıştır; ancak bir fısıltı işitirsin",
      "kaynak": "Tâhâ Suresi, 105. Ayet"
    },
    {
      "metin": "Allah, yaptıklarının karşılığını en güzel şekilde kendilerine vermek üzere, az veya çok sarfettikleri her şey, yürüdükleri her yol, onlar için yazılır",
      "kaynak": "Tevbe Suresi, 121. Ayet"
    },
    {
      "metin": "Kendisine böylece yazık ederek bahçesine girerken: \"Bu bahçenin batacağını hiç zannetmem. Kıyametin kopacağını da sanmıyorum. Eğer Rabbime döndürülürsem, and olsun ki orada bundan daha iyisini bulurum\" dedi",
      "kaynak": "Kehf Suresi, 35. Ayet"
    },
    {
      "metin": "Ey inananlar! Evlerinizden başka evlere, izin almadan, seslenip sahiplerine selam vermeden girmeyiniz. Eğer düşünürseniz bu sizin için daha iyidir",
      "kaynak": "Nûr Suresi, 27. Ayet"
    },
    {
      "metin": "Onlar, her ne zaman bir ahidde bulunmuşlarsa içlerinden bir takımı onu bozmamış mıdır? Zaten onların çoğu inanmazlar",
      "kaynak": "Bakara Suresi, 100. Ayet"
    },
    {
      "metin": "Babalarının emrettiği gibi girdiler. Esasen bu, Allah katında onlara bir fayda sağlamazdı, ancak Yakub içindeki arzuyu ortaya koymuş oldu. O, şüphesiz kendisine öğrettiğimizi bilir fakat insanların çoğu bilmezler",
      "kaynak": "Yûsuf Suresi, 68. Ayet"
    },
    {
      "metin": "Haksızlıklarından ötürü işte yok ettiğimiz şehirler! Onları yok etmek için bir süre tayin etmiştik",
      "kaynak": "Kehf Suresi, 59. Ayet"
    },
    {
      "metin": "İnsanlar, yerde yürüyenler ve davarlar da böyle türlü türlü renktedirler. Allah'ın kulları arasında O'ndan korkan, ancak bilginlerdir. Doğrusu Allah güçlüdür, bağışlayandır",
      "kaynak": "Fâtır Suresi, 28. Ayet"
    },
    {
      "metin": "And olsun ki, Musa ve Harun'a eğriyi doğrudan ayıran Kitap'ı sakınanlar için ışık ve öğüt olarak verdik",
      "kaynak": "Enbiyâ Suresi, 48. Ayet"
    },
    {
      "metin": "Bu dünyada kalbi kör olan, ahirette de kör ve daha şaşkındır",
      "kaynak": "İsrâ Suresi, 72. Ayet"
    },
    {
      "metin": "Sözlerini bozdukları için onlara lanet ettik, kalblerini katılaştırdık. Onlar sözleri yerlerinden değiştirirler. Kendilerine belletilenin bir kısmını unuttular. İçlerinden pek azından başkasının daima hainliklerini görürsün, onları affet ve geç. Allah iyilik yapanları şüphesiz sever",
      "kaynak": "Mâide Suresi, 13. Ayet"
    },
    {
      "metin": "Göklerde olanlar da, yerde olanlar da Allah'ındır. Dilediğini bağışlar, dilediğine azab eder. Allah bağışlayandır, merhamet edendir",
      "kaynak": "Âl-i İmrân Suresi, 129. Ayet"
    },
    {
      "metin": "O, sizi çamurdan yaratan, sonra size bir ecel tayin edendir. Belirli bir ecel O'nun katındadır; sonra bir de şüphe edersiniz",
      "kaynak": "En'âm Suresi, 2. Ayet"
    },
    {
      "metin": "Medyen'e doğru yöneldiğinde: \"Rabbimin bana doğru yolu göstereceğini umarım\" dedi",
      "kaynak": "Kasas Suresi, 22. Ayet"
    },
    {
      "metin": "İnkar edenler: \"Bu Kuran uydurmadır, ona başka bir topluluk yardım etmiştir\" diyerek haksız ve asılsız bir söz uydurdular",
      "kaynak": "Furkân Suresi, 4. Ayet"
    },
    {
      "metin": "Bu böyledir; kişinin Allah'ın nişanelerine hürmet göstermesi, kalblerin Allah'a karşı gelmekten sakınmasındandır",
      "kaynak": "Hac Suresi, 32. Ayet"
    },
    {
      "metin": "Eğer evde kimseyi bulamazsanız, yine de size izin verilmedikçe içeriye girmeyiniz. Size \"Dönün\" denirse dönün. Bu, sizi daha çok temize çıkarır. Allah yaptıklarınızı bilir",
      "kaynak": "Nûr Suresi, 28. Ayet"
    },
    {
      "metin": "Onu yudum yudum alacak fakat yutamıyacaktır. Ölüm ona her taraftan geldiği halde, ölemiyecek, arkasından da çetin bir azap gelecektir",
      "kaynak": "İbrâhîm Suresi, 17. Ayet"
    },
    {
      "metin": "İnsanı nutfeden yaratmıştır. Öyleyken o nasıl da açıkça karşı koymaktadır",
      "kaynak": "Nahl Suresi, 4. Ayet"
    },
    {
      "metin": "Kendilerine: \"Yeryüzünde bozgunculuk yapmayın\" dendiği zaman, \"Bizler sadece ıslah edicileriz\" derler",
      "kaynak": "Bakara Suresi, 11. Ayet"
    },
    {
      "metin": "Firavun taifesi ve onlardan öncekilerin gidişi gibi, Rablerinin ayetlerini yalanladılar da onları günahlarından ötürü yok ettik. Firavun taifesini suda boğduk, hepsi zalimlerdi",
      "kaynak": "Enfâl Suresi, 54. Ayet"
    },
    {
      "metin": "Böylece onları, iki gün içinde yedi göğe tamamladı ve her göğün işini kendisine bildirdi. Yakın göğü ışıklarla donattık ve bozulmaktan koruduk. İşte bu, bilen, güçlü olan Allah'ın kanunudur",
      "kaynak": "Fussilet Suresi, 12. Ayet"
    },
    {
      "metin": "Elini koynuna koy, lekesiz, bembeyaz çıksın. Korkudan açılan kollarını kendine çek! Bu ikisi Firavun ve erkanına karşı Rabbinin iki delilidir. Doğrusu onlar yoldan çıkmış bir millettir\" denildi",
      "kaynak": "Kasas Suresi, 32. Ayet"
    },
    {
      "metin": "Bize yalnız Allah'a kulluk etmemizi, babalarımızın taptıklarını bırakmamızı söylemek için mi geldin? Doğru sözlülerden isen haydi bizi tehdit ettiğin azaba uğrat\" dediler",
      "kaynak": "A'râf Suresi, 70. Ayet"
    },
    {
      "metin": "Yoksa, kötülük işleyen kimseler, ölümlerinde ve diriliklerinde kendilerini, inanıp yararlı iş işleyen kimseler ile bir mi tutacağımızı sandılar? Ne kötü hüküm veriyorlar",
      "kaynak": "Câsiye Suresi, 21. Ayet"
    },
    {
      "metin": "Evlerinizde oturun; eski Cahiliyye'de olduğu gibi açılıp saçılmayın; namazı kılın; zekatı verin; Allah'a ve Peygamberine itaat edin. Ey Peygamberin ev halkı! (ehl-i beyt) Şüphesiz Allah sizden kusuru giderip sizi tertemiz yapmak ister",
      "kaynak": "Ahzâb Suresi, 33. Ayet"
    },
    {
      "metin": "Katımızdan bir buyrukla, her hikmetli işe o gecede hükmedilir. Doğrusu Biz öteden beri peygamberler göndermekteyiz. Eğer kesin olarak inanırsanız bilin ki, bu senin Rabbinden, göklerin, yerin ve ikisi arasında bulunanların Rabbinden bir rahmettir. O, işitendir, bilendir",
      "kaynak": "Duhân Suresi, 5. Ayet"
    },
    {
      "metin": "De ki: \"Acele istediğiniz şey elimde olsaydı, benimle aranızdaki iş bitmiş olurdu.\" Allah zulmedenleri en iyi bilendir",
      "kaynak": "En'âm Suresi, 58. Ayet"
    },
    {
      "metin": "İnananlara: \"Rabbinizin size gönderilmiş üç bin melekle yardım etmesi size yetmeyecek mi?\" diyordun. Evet, eğer sabrederseniz, sakınırsanız ve onlar de hemen üzerinize gelirlerse Rabbiniz size, nişanlı beş bin melekle imdat edecektir",
      "kaynak": "Âl-i İmrân Suresi, 124. Ayet"
    },
    {
      "metin": "Göklerde ve yerde olanlar Allah'ındır. Şüphesiz Allah müstağnidir, övülmeğe layıktır",
      "kaynak": "Lokmân Suresi, 26. Ayet"
    },
    {
      "metin": "Allah'ı gereği gibi değerlendiremediler. Doğrusu Allah kuvvetlidir, güçlüdür",
      "kaynak": "Hac Suresi, 74. Ayet"
    },
    {
      "metin": "O, gökleri ve yeri yoktan yaratandır. Zevcesi olmadan nasıl çocuğu olabilir? Oysa her şeyi O yaratmıştır, her şeyi bilir",
      "kaynak": "En'âm Suresi, 101. Ayet"
    },
    {
      "metin": "O ve askerleri, memlekette, haksız yere büyüklük tasladılar. Gerçekten Bize döndürülmeyeceklerini sandılar",
      "kaynak": "Kasas Suresi, 39. Ayet"
    },
    {
      "metin": "Sabah akşam Rablerinin rızasını dileyerek O'na yalvaranlarla beraber sen de sabret. Dünya hayatının güzelliklerini isteyerek gözlerini o kimselerden ayırma. Bizi anmasını kendisine unutturduğumuz ve işinde aşırı giderek hevesine uyan kimseye uyma",
      "kaynak": "Kehf Suresi, 28. Ayet"
    },
    {
      "metin": "Firavun: \"Beni bırakın da Musa'yı öldüreyim, o, Rabbine yalvaradursun. Onun, sizin dininizi değiştireceğinden veya yeryüzünde bozgun çıkaracağından korkuyorum\" dedi",
      "kaynak": "Mü'min Suresi, 26. Ayet"
    },
    {
      "metin": "Ayetlerimizi yalan sayanları, bilmedikleri yönden, ağır ağır sonuçlarına yaklaştıracağız",
      "kaynak": "A'râf Suresi, 182. Ayet"
    },
    {
      "metin": "İnananlara: \"Rabbinizin size gönderilmiş üç bin melekle yardım etmesi size yetmeyecek mi?\" diyordun. Evet, eğer sabrederseniz, sakınırsanız ve onlar de hemen üzerinize gelirlerse Rabbiniz size, nişanlı beş bin melekle imdat edecektir",
      "kaynak": "Âl-i İmrân Suresi, 125. Ayet"
    },
    {
      "metin": "Rabbinin ayetleri kendisine hatırlatılıp da onlardan yüz çeviren kimseden daha zalim var mıdır? Şüphesiz suçlulardan öç alacağız",
      "kaynak": "Secde Suresi, 22. Ayet"
    },
    {
      "metin": "Küfürde yarışanlar seni üzmesin; şüphesiz onlar Allah'a bir zarar veremezler. Allah ahirette onlara bir pay vermemek istiyor; onlara büyük azab vardır",
      "kaynak": "Âl-i İmrân Suresi, 176. Ayet"
    },
    {
      "metin": "And olsun ki, Biz vahyi onlara ard arda yetiştirdik; belki düşünürler",
      "kaynak": "Kasas Suresi, 51. Ayet"
    },
    {
      "metin": "O sırada, kadınlardan biri utana utana yürüyüp ona geldi: \"Babam sana sulama ücretini ödemek için seni çağırıyor\" dedi. Musa ona gelince, başından geçeni anlattı. O: \"Korkma, artık zalim milletten kurtuldun\" dedi",
      "kaynak": "Kasas Suresi, 25. Ayet"
    },
    {
      "metin": "Allah'ın geceyi gündüze ve gündüzü geceye kattığını, her biri belirli bir süreye kadar hareket edecek olan güneşi ve ayı buyruk altında tuttuğunu; Allah'ın, yaptıklarınızdan haberdar olduğunu bilmez misin",
      "kaynak": "Lokmân Suresi, 29. Ayet"
    },
    {
      "metin": "Ey İsrailoğulları! Size verdiğim nimeti ve sizi bir zamanlar alemlere üstün kıldığımı hatırlayın",
      "kaynak": "Bakara Suresi, 47. Ayet"
    },
    {
      "metin": "Allah'ın yarattığı şeylerin, gölgeleri sağa sola vurarak, Allah'a boyun eğerek secde etmekte olduklarını görmüyorlar mı",
      "kaynak": "Nahl Suresi, 48. Ayet"
    },
    {
      "metin": "Göklerin ve yerin yaratılması, insanların yaratılmasından daha büyük bir şeydir. Fakat insanların çoğu bilmezler",
      "kaynak": "Mü'min Suresi, 57. Ayet"
    },
    {
      "metin": "Kadınların babası: \"Bana sekiz yıl çalışmana karşılık bu iki kızımdan birini sana nikahlamak istiyorum. Eğer on yıla tamamlarsan o senden bir lütuf olur. Ama sana ağırlık vermek istemem. İnşallah beni iyi kimselerden bulacaksın\" dedi",
      "kaynak": "Kasas Suresi, 27. Ayet"
    },
    {
      "metin": "Rabbinin rahmetini onlar mı taksim edip paylaştırıyorlar? Dünya hayatında onların geçimliklerini aralarında Biz taksim ettik; birbirlerine iş gördürmeleri için kimini kimine derecelerle üstün kıldık; Rabbinin rahmeti, onların biriktirdikleri şeylerden daha iyidir",
      "kaynak": "Zuhruf Suresi, 32. Ayet"
    },
    {
      "metin": "İşte herşeyin yaratıcısı olan Rabbiniz Allah budur. O'ndan başka tanrı yoktur. Nasıl aldatılıp döndürülürsünüz",
      "kaynak": "Mü'min Suresi, 62. Ayet"
    },
    {
      "metin": "Sonra Allah'ın ayetlerini yalan sayıp, onları alaya alarak kötülük yapanların sonu pek kötü oldu",
      "kaynak": "Rûm Suresi, 10. Ayet"
    },
    {
      "metin": "Kim bir kötülük işlerse ancak onun kadar ceza görür. Kadın veya erkek, kim, inanarak yararlı iş işlerse, işte onlar cennete girerler; orada hesapsız şekilde rızıklanırlar",
      "kaynak": "Mü'min Suresi, 40. Ayet"
    },
    {
      "metin": "Evinde bulunduğu kadın onu kendine çağırdı, kapıları sıkı sıkı kapadı ve \"gelsene\" dedi. Yusuf: \"Günah işlemekten Allah'a sığınırım, doğrusu senin kocan benim efendimdir; bana iyi baktı. Haksızlık yapanlar şüphesiz başarıya ulaşamazlar.\" dedi",
      "kaynak": "Yûsuf Suresi, 23. Ayet"
    },
    {
      "metin": "Yakınlığı olana, yoksula, yolda kalmışa hakkını ver. Allah'ın rızasını dileyenler için bu daha hayırlıdır. İşte onlar saadete erenlerdir",
      "kaynak": "Rûm Suresi, 38. Ayet"
    },
    {
      "metin": "Musa'ya hükmümüzü bildirdiğimiz zaman, sen batı yönünde, (Musa'yı bekleyenler arasında) değildin, onu görenler arasında da yoktun",
      "kaynak": "Kasas Suresi, 44. Ayet"
    },
    {
      "metin": "Bu, Allah'ın vaadidir; Allah verdiği sözden caymaz, fakat insanların çoğu bilmezler",
      "kaynak": "Rûm Suresi, 6. Ayet"
    },
    {
      "metin": "O inanan kimse dedi ki: \"Ey milletim! Bana uyun, sizi doğru yola eriştireyim",
      "kaynak": "Mü'min Suresi, 38. Ayet"
    },
    {
      "metin": "Ey milletim; Bugün memlekette hükümranlık sizindir, galip olanlar sizsiniz. Ama Allah'ın baskını bize çatınca, O'na karşı bize kim yardım eder?\" Firavun: \"Ben size kendi görüşümden başkasını söylemiyorum. Ben size ancak doğru yolu gösteriyorum\" dedi",
      "kaynak": "Mü'min Suresi, 29. Ayet"
    },
    {
      "metin": "O, görülmeyeni de görüleni de bilendir, güçlüdür, merhametlidir",
      "kaynak": "Secde Suresi, 6. Ayet"
    },
    {
      "metin": "Onlar: \"Bir şey yapacaksanız, şunu yakın da tanrılarınıza yardım edin\" dediler",
      "kaynak": "Enbiyâ Suresi, 68. Ayet"
    },
    {
      "metin": "And olsun ki Musa'ya Kitap vermiştik de onda ayrılığa düşmüşlerdi. Rabbinin verilmiş bir sözü olmasaydı, aralarında hükmedilmiş olurdu. Doğrusu onlar, onun hakkında şüphe ve endişe içindedirler",
      "kaynak": "Fussilet Suresi, 45. Ayet"
    },
    {
      "metin": "Şehirde, korku içinde etrafı gözetip dolaşarak sabahladı. Dün kendisinden yardım isteyen kimse bağırarak ondan yine yardım istiyordu. Musa ona: \"Doğrusu sen besbelli bir azgınsın\" dedi",
      "kaynak": "Kasas Suresi, 18. Ayet"
    },
    {
      "metin": "Yoksa Yakub can verirken sizler yanında mı idiniz? O, oğullarına: \"Benden sonra kime kulluk edeceksiniz?\" diye sormuştu; Onlar da: \"Senin Tanrına ve ataların İbrahim, İsmail, İshak'ın Tanrısı olan tek Tanrıya kulluk edeceğiz, bizler O'na teslim olmuşuzdur\" demişlerdi",
      "kaynak": "Bakara Suresi, 133. Ayet"
    },
    {
      "metin": "And olsun ki, \"Allah ancak Meryem oğlu Mesih'tir\" diyenler kafir oldular. Oysa Mesih, \"Ey İsrailoğulları! Rabbim ve Rabbiniz olan Allah'a kulluk edin; kim Allah'a ortak koşarsa muhakkak Allah ona cenneti haram eder, varacağı yer ateştir, zulmedenlerin yardımcıları yoktur\" dedi",
      "kaynak": "Mâide Suresi, 72. Ayet"
    },
    {
      "metin": "Benden önce gelen Tevrat'ı tasdik etmekle beraber size yasak edilenlerin bir kısmını helal kılmak üzere, Rabbinizden size bir ayet getirdim. Allah'tan sakının ve bana itaat edin; çünkü Allah benim de Rabbim, sizin de Rabbinizdir. O'na kulluk edin, bu doğru yoldur",
      "kaynak": "Âl-i İmrân Suresi, 51. Ayet"
    },
    {
      "metin": "Orada, uğradıkları gamdan ne zaman çıkmak isteseler her defasında oraya geri çevrilirler: \"Yakıcı azabı tadın\" denir",
      "kaynak": "Hac Suresi, 22. Ayet"
    },
    {
      "metin": "Yarattığı her şeyi güzel yaratan, insanı başlangıçta çamurdan yaratan, sonra onun soyunu, bayağı bir suyun özünden yapan, sonra onu şekillendirip ruhundan ona üfleyen Allah'tır. Size kulaklar, gözler, kalbler verilmiştir. Öyleyken, pek az şükrediyorsunuz",
      "kaynak": "Secde Suresi, 9. Ayet"
    },
    {
      "metin": "Musa ve kardeşine: \"Mısır'da milletinize evler hazırlayın; evlerinizi namazgah edinin, namaz kılın\" diye vahyettik, \"İnananlara müjde et",
      "kaynak": "Yûnus Suresi, 87. Ayet"
    },
    {
      "metin": "Doğrusu bu Kuran sana ve ümmetine bir öğüttür, ondan sorumlu tutulacaksınız",
      "kaynak": "Zuhruf Suresi, 44. Ayet"
    },
    {
      "metin": "Aşağılıktan başları öne eğilmiş, göz ucuyla gizli gizli etrafa bakarken, ateşe sunulduklarını görürsün. İnananlar: \"Hüsranda olanlar, kıyamet günü kendilerini de, ailelerini de hüsranda bırakanlardır\" derler. İyi bilin ki, zalimler sürekli bir azap içindedirler",
      "kaynak": "Şûrâ Suresi, 45. Ayet"
    },
    {
      "metin": "İnkarcılara, ikiyüzlülere itaat etme; eziyetlerine aldırma; Allah'a güven, güvenilecek olarak Allah yeter",
      "kaynak": "Ahzâb Suresi, 48. Ayet"
    },
    {
      "metin": "Size korku ve ümit veren şimşeği göstermesi, gökten su indirip ölümünden sonra yeri onunla diriltmesi O'nun varlığının belgelerindendir. Bunlarda, düşünen millet için dersler vardır",
      "kaynak": "Rûm Suresi, 24. Ayet"
    },
    {
      "metin": "Size söylediğimi hatırlayacaksınız. Ben işimi Allah'a bırakıyorum. Doğrusu Allah, kulları görür",
      "kaynak": "Mü'min Suresi, 44. Ayet"
    },
    {
      "metin": "Ana babanın ve yakınların bıraktıklarından her birine varisler kıldık. Kendileriyle yeminleştiğiniz kimselere hisselerini veriniz. Doğrusu Allah her şeye şahiddir",
      "kaynak": "Nisâ Suresi, 33. Ayet"
    },
    {
      "metin": "Seni onlardan uzaklaştırsak bile doğrusu Biz kendilerinden öç alırız; yahut onlara vadettiğimizi sana gösteririz. Çünkü onlara karşı gücü yetenleriz",
      "kaynak": "Zuhruf Suresi, 42. Ayet"
    },
    {
      "metin": "O gün her ümmetin ayetlerimizi yalanlayanlarını toplarız. Onlar bir arada tutulup, hesap yerine sevkedilirler",
      "kaynak": "Neml Suresi, 83. Ayet"
    },
    {
      "metin": "Sana Rabbinden vahyolunana uy; şüphesiz Allah, yaptıklarınızdan haberdardır",
      "kaynak": "Ahzâb Suresi, 2. Ayet"
    },
    {
      "metin": "And olsun ki, İsrailoğullarını, azgın bir zorba olan Firavun'un alçaltıcı azabından kurtardık",
      "kaynak": "Duhân Suresi, 30. Ayet"
    },
    {
      "metin": "Rabbim! O putlar çok insanları saptırdı; bana uyan bendendir, bana karşı gelen kimseyi Sana bırakırım; Sen bağışlarsın, merhamet edersin",
      "kaynak": "İbrâhîm Suresi, 36. Ayet"
    },
    {
      "metin": "Kuran onlara okunduğu zaman: \"Ona inandık, doğrusu o Rabbimizden gelen gerçektir; biz şüphesiz daha önceden müslüman olmuş kimseleriz\" derler",
      "kaynak": "Kasas Suresi, 53. Ayet"
    },
    {
      "metin": "İbrahim: \"Ey Elçiler! Göreviniz nedir?\" dedi",
      "kaynak": "Zâriyât Suresi, 31. Ayet"
    },
    {
      "metin": "Biz, and olsun ki öğüt almaları için bu Kuran'da bunları türlü türlü açıkladık. Fakat bu açıklamalar ancak onların nefretini artırmıştır",
      "kaynak": "İsrâ Suresi, 41. Ayet"
    },
    {
      "metin": "İnkar edenler: \"Biz ve babalarımız toprak olduğumuzda mı, doğrusu bizler mi tekrar çıkarılacağız? Bununla biz de, daha önce babalarımız da, and olsun ki, tehdit edilmiştik. Bu, öncekilerin masallarından başka bir şey değildir\" dediler",
      "kaynak": "Neml Suresi, 68. Ayet"
    },
    {
      "metin": "Kardeşleri Nuh, onlara: \"Allah'a karşı gelmekten sakınmaz mısınız? Doğrusu ben size gönderilmiş güvenilir bir elçiyim. Allah'tan sakının ve bana itaat edin. Buna karşı sizden bir ücret istemiyorum. Benim ecrim ancak Alemlerin Rabbine aittir. Artık Allah'tan sakının ve bana itaat edin\" dedi",
      "kaynak": "Şuarâ Suresi, 107. Ayet"
    },
    {
      "metin": "De ki: \"Ben, yalnız her şeyin sahibi olan ve bu kutlu kılınmış şehrin Rabbine kulluk etmekle emrolundum. Müslümanlardan olmakla ve Kuran okumakla emrolundum.\" Kim doğru yolu bulmuşsa, yalnız kendisi için bulmuş olur, kim sapıtmışsa kendine etmiş olur. De ki: \"Ben sadece, uyaranlardan biriyim",
      "kaynak": "Neml Suresi, 92. Ayet"
    },
    {
      "metin": "Göklerin ve yerin kilitleri O'nundur. Dilediğine rızkı yayar ve isterse kısar, bir ölçüye göre verir. Doğrusu O herşeyi bilendir",
      "kaynak": "Şûrâ Suresi, 12. Ayet"
    },
    {
      "metin": "Ey milletim! Ben beyinsiz değil, Alemlerin Rabbinin peygamberiyim",
      "kaynak": "A'râf Suresi, 67. Ayet"
    },
    {
      "metin": "De ki: \"Göklerde ve yerde gaybı Allah'tan başka bilen yoktur.\" Ne zaman diriltileceklerini de bilmezler",
      "kaynak": "Neml Suresi, 65. Ayet"
    },
    {
      "metin": "Allah inananları, dünya hayatında ve ahirette sağlam bir söz üzerinde tutar; zalimleri de saptırır. Allah dilediğini yapar",
      "kaynak": "İbrâhîm Suresi, 27. Ayet"
    },
    {
      "metin": "Dağları yerinde donmuş gibi durur görürsün, oysa onlar bulutlar gibi geçerler. Bu her şeyi sağlam tutan Allah'ın işidir. Doğrusu O, yaptıklarınızdan haberdardır",
      "kaynak": "Neml Suresi, 88. Ayet"
    },
    {
      "metin": "Allah'a yönelerek O'na karşı gelmekten sakınınız, namaz kılınız, dinlerinde ayrılığa düşüp fırka fırka olan, her fırkasının da kendisinde bulunanla sevindiği müşriklerden olmayınız",
      "kaynak": "Rûm Suresi, 31. Ayet"
    },
    {
      "metin": "Daha önce de Nuh milletini cezalandırmıştık. Çünkü onlar da yoldan çıkmış bir milletti",
      "kaynak": "Zâriyât Suresi, 46. Ayet"
    },
    {
      "metin": "Göklerde ve yerde olanlar O'nundur; hepsi O'na boyun eğmiştir",
      "kaynak": "Rûm Suresi, 26. Ayet"
    },
    {
      "metin": "Peygamberlerden söz almıştık. Senden, Nuh'dan, İbrahim'den, Musa'dan, Meryem oğlu İsa'dan sağlam bir söz almışızdır",
      "kaynak": "Ahzâb Suresi, 7. Ayet"
    },
    {
      "metin": "Ey Adem! Doğrusu bu, senin ve eşinin düşmanıdır. Sakın sizi cennetten çıkarmasın, yoksa bedbaht olursun. Doğrusu cennette ne acıkırsın, ne de çıplak kalırsın; orada ne susarsın ne de güneşin sıcağında kalırsın\" dedik",
      "kaynak": "Tâhâ Suresi, 118. Ayet"
    },
    {
      "metin": "Bütün melekler secde etmişlerdi, fakat İblis; o, büyüklük taslamış ve inkarcılardan olmuştu",
      "kaynak": "Sâd Suresi, 73. Ayet"
    },
    {
      "metin": "Ahiret kazancını isteyenin kazancını artırırız; dünya kazancını isteyene de ondan veririz; ama ahirette bir payı bulunmaz",
      "kaynak": "Şûrâ Suresi, 20. Ayet"
    },
    {
      "metin": "Büyüklük taslayanlar, \"Sizin inandığınızı biz inkar ediyoruz\" dediler ve dişi deveyi kesip devirdiler; Rablerinin buyruğuna baş kaldırdılar, \"Ey Salih, eğer sen peygambersen bizi tehdit ettiğin azaba uğrat bakalım\" dediler",
      "kaynak": "A'râf Suresi, 77. Ayet"
    },
    {
      "metin": "Bugün herkese, kazandığının karşılığı verilir. Bugün haksızlık yoktur. Doğrusu Allah, hesabı çabuk görendir",
      "kaynak": "Mü'min Suresi, 17. Ayet"
    },
    {
      "metin": "Allah sana bir sıkıntı verirse, O'ndan başkası gideremez. Sana bir iyilik verirse başkası onu engelleyemez. O, her şeye Kadir'dir",
      "kaynak": "En'âm Suresi, 17. Ayet"
    },
    {
      "metin": "Allah'a ve Peygambere itaat eden, Allah'tan korkan ve O'ndan sakınan kimseler, işte onlar kurtulanlardır",
      "kaynak": "Nûr Suresi, 52. Ayet"
    },
    {
      "metin": "Dedikleri ancak şu idi: \"Rabbimiz! Günahlarımızı, işimizdeki aşırılıklarımızı bize bağışla, sebatımızı arttır, inkarcı topluluğa karşı bize yardım et",
      "kaynak": "Âl-i İmrân Suresi, 147. Ayet"
    },
    {
      "metin": "Biz de, onu ve askerlerini yakalayıp suya attık. Zalimlerin sonunun nasıl olduğuna bir bak",
      "kaynak": "Kasas Suresi, 40. Ayet"
    },
    {
      "metin": "Kıyamet koptuğu gün suçlular umutsuz kalıverirler",
      "kaynak": "Rûm Suresi, 12. Ayet"
    },
    {
      "metin": "Allah: \"Ey İblis! Secde edenlerle beraber olmaktan seni alıkoyan nedir?\" dedi",
      "kaynak": "Hicr Suresi, 32. Ayet"
    },
    {
      "metin": "De ki: \"İnsanlar ve cinler, birbirine yardımcı olarak bu Kuran'ın bir benzerini ortaya koymak için bir araya gelseler, and olsun ki, yine de benzerini ortaya koyamazlar",
      "kaynak": "İsrâ Suresi, 88. Ayet"
    },
    {
      "metin": "Kitap'ı ve peygamberlerimize gönderdiklerimizi yalanlayanlar elbette bileceklerdir",
      "kaynak": "Mü'min Suresi, 70. Ayet"
    },
    {
      "metin": "De ki: \"Hamd Allah'a mahsustur, seçtiği kullarına selam olsun. Allah mı daha iyidir, yoksa O'na koştukları ortaklar mı",
      "kaynak": "Neml Suresi, 59. Ayet"
    },
    {
      "metin": "Yusuf: \"Beni memleketin hazinelerine memur et, çünkü ben korumasını ve yönetmesini bilirim\" dedi",
      "kaynak": "Yûsuf Suresi, 55. Ayet"
    },
    {
      "metin": "Bunlar apaçık Kitap'ın ayetleridir",
      "kaynak": "Kasas Suresi, 2. Ayet"
    },
    {
      "metin": "De ki: \"Allah'tan başka tanrı olduğunu sandıklarınızı çağırın; sizin bir sıkıntınızı gidermeye ve onu değiştirmeye güçleri yetmez",
      "kaynak": "İsrâ Suresi, 56. Ayet"
    },
    {
      "metin": "Allah inananları sizin durumunuzda bırakacak değildir, temizi pisten ayıracaktır. Allah size gaybı bildirecek değildir; fakat Allah peygamberlerinden dilediğini seçip, ona gaybı bildirir. Artık Allah'a ve peygamberlerine inanın; inanır ve sakınırsanız size büyük ecir vardır",
      "kaynak": "Âl-i İmrân Suresi, 179. Ayet"
    },
    {
      "metin": "Rablerinin mağfiret ve rahmeti onlaradır. O'nun yolunda olanlar da onlardır",
      "kaynak": "Bakara Suresi, 157. Ayet"
    },
    {
      "metin": "İnsanların fırka fırka olacağı, Allah katından kaçınılmaz o günün gelmesinden önce, kendini dosdoğru dine yönelt",
      "kaynak": "Rûm Suresi, 43. Ayet"
    },
    {
      "metin": "İçinizden cumartesi günü azgınlık edenleri elbette biliyorsunuz. Onlara \"Aşağılık birer maymun olunuz\" dedik; bunu, çağdaşlarına ve sonradan geleceklere bir ceza örneği ve Allah'a karşı gelmekten sakınanlara öğüt olsun diye yaptık",
      "kaynak": "Bakara Suresi, 65. Ayet"
    },
    {
      "metin": "Sonra peygamberlerin ardından Musa'yı ayetlerimizle Firavun ve erkanına gönderdik. Ayetlerimize karşı haksızlık ettiler. Bozguncuların sonunun nasıl olduğuna bir bak",
      "kaynak": "A'râf Suresi, 103. Ayet"
    },
    {
      "metin": "Allah kimin gönlünü İslam'a açmışsa, o, Rabbi katından bir nur üzere olmaz mı? Kalbleri Allah'ı anmak hususunda katılaşmış olanlara yazıklar olsun; işte bunlar apaçık sapıklıktadırlar",
      "kaynak": "Zümer Suresi, 22. Ayet"
    },
    {
      "metin": "Musa: \"Rabbim! Doğrusu ben onlardan bir cana kıydım. Beni öldürmelerinden korkarım. Kardeşim Harun'un dili benimkinden daha düzgündür. Onu, beni destekleyen bir yardımcı olarak benimle gönder, çünkü beni yalanlamalarından korkarım\" dedi",
      "kaynak": "Kasas Suresi, 34. Ayet"
    },
    {
      "metin": "İnanmışlara de ki: Allah'ın bir milleti yaptıklarına karşılık cezalandıracağı günlerin geleceğini ummayanları şimdilik bağışlasınlar",
      "kaynak": "Câsiye Suresi, 14. Ayet"
    },
    {
      "metin": "Allah onları kurtarınca, hemen yeryüzünde haksız yere taşkınlıklara başlarlar. Ey insanlar! Geçici dünya hayatında yaptığınız taşkınlık aleyhinizedir. Sonra dönüşünüz Bizedir. Yaptıklarınızı size bildiririz",
      "kaynak": "Yûnus Suresi, 23. Ayet"
    },
    {
      "metin": "De ki: Bundan daha iyisini size haber vereyim mi? Allah'a karşı gelmekten sakınanlara, Rab'lerinin katında, altlarından ırmaklar akan ve orada temelli kalacakları cennetler, tertemiz eşler ve Allah'ın rızası vardır. Allah kullarını hakkiyle görücüdür",
      "kaynak": "Âl-i İmrân Suresi, 15. Ayet"
    },
    {
      "metin": "Rabbe kul olanlar ve bilginlerin onlara günah söz söylemeyi ve haram yemeyi yasak etmeleri gerekmez miydi? Yapmakta oldukları ne kötüdür",
      "kaynak": "Mâide Suresi, 63. Ayet"
    },
    {
      "metin": "De ki: \"Ben, dinimi Allah'a halis kılarak O'na kulluk ederim",
      "kaynak": "Zümer Suresi, 14. Ayet"
    },
    {
      "metin": "Onlardan ileri gelenler: \"Yürüyün, tanrılarınıza bağlılıkta direnin, sizden istenen şüphesiz budur. Başka dinde de bunu işitmedik; bu ancak bir uydurmadır. Kuran, aramızda ona mı indirilmeliydi?\" dediler. Hayır, bunlar Kuran'ımızdan şüphededirler. Hayır, azabımızı henüz tatmamışlardır",
      "kaynak": "Sâd Suresi, 6. Ayet"
    },
    {
      "metin": "Senden önce gönderdiğimiz bütün peygamberler de, şüphesiz, yemek yerler, sokaklarda gezerlerdi. Ey insanlar! Sabreder misiniz diye sizi birbirinizle sınarız. Rabbin her şeyi görür",
      "kaynak": "Furkân Suresi, 20. Ayet"
    },
    {
      "metin": "Doğrusu günahkarların yiyeceği zakkum ağacıdır; karınlarda suyun kaynaması gibi kaynayan, erimiş maden gibidir",
      "kaynak": "Duhân Suresi, 44. Ayet"
    },
    {
      "metin": "Sana sebat vermemiş olsaydık, and olsun ki, az da olsa onlara meyledecektin",
      "kaynak": "İsrâ Suresi, 74. Ayet"
    },
    {
      "metin": "Ey Kitap ehli! Peygamberlerin arası kesildiğinde, \"Bize müjdeci ve uyarıcı gelmedi\" dersiniz diye, size açıkça anlatacak peygamberimiz geldi. Şüphesiz O, size müjdeci ve uyarıcı olarak gelmiştir. Allah her şeye Kadir'dir",
      "kaynak": "Mâide Suresi, 19. Ayet"
    },
    {
      "metin": "Gökten suyu ölçülü indirdik de, onu yerde durdurduk. Şüphesiz onu gidermeye de kadiriz",
      "kaynak": "Mü'minûn Suresi, 18. Ayet"
    },
    {
      "metin": "Rabbimiz! Bize dünyada iyiyi, ahirette de iyiyi ver, bizi ateşin azabından koru\" diyenler vardır",
      "kaynak": "Bakara Suresi, 201. Ayet"
    },
    {
      "metin": "De ki: \"Yeryüzünde dolaşın da daha öncekilerden çoğu ortak koşan (müşrik) olanların sonunun nasıl olduğuna bir bakın",
      "kaynak": "Rûm Suresi, 42. Ayet"
    },
    {
      "metin": "Ey Allah'a eş koşanlar! Siz de O'ndan başka dilediğinize kulluk edin.\" De ki: Hüsrana uğrayanlar kıyamet günü kendilerini ve ailelerini hüsrana sokanlardır. Dikkat edin, işte apaçık hüsran budur",
      "kaynak": "Zümer Suresi, 15. Ayet"
    },
    {
      "metin": "Elçiler: \"Suçlu bir milletin üzerine, Rabbinin katından işaretli olarak, aşırı gidenlere mahsus sert taşlar göndermekle görevlendirildik\" dediler",
      "kaynak": "Zâriyât Suresi, 32. Ayet"
    },
    {
      "metin": "Sura üfürüldüğü gün, Allah'ın diledikleri bir yana, göklerde olanlar da yerde olanlar da, korku içinde kalırlar. Hepsi Allah'a boyunları bükülmüş olarak gelirler",
      "kaynak": "Neml Suresi, 87. Ayet"
    },
    {
      "metin": "Geri dönerseniz yeryüzünde bozgunculuk yapmanız ve akrabalık bağlarını kesmeniz beklenmez mi sizden",
      "kaynak": "Muhammed Suresi, 22. Ayet"
    },
    {
      "metin": "Aralarından bir uyarıcının gelmesine şaşmışlardı. İnkarcılar: \"Bu, pek yalancı bir sihirbazdır; tanrıları tek bir tanrı mı yaptı? Doğrusu bu tuhaf bir şeydir\" demişlerdi",
      "kaynak": "Sâd Suresi, 4. Ayet"
    },
    {
      "metin": "Esip savuran rüzgarlara, yağmur yüklü bulutlara, kolayca süzülen gemiler ve işleri yöneten meleklere and olsun ki, size söz verilen kıyametin kopması şüphesiz gerçektir. Ödeşme günü gelecektir",
      "kaynak": "Zâriyât Suresi, 6. Ayet"
    },
    {
      "metin": "Ona altın bilezikler verilmeli veya yanında ona yardım edecek melekler gelmeli değil mi",
      "kaynak": "Zuhruf Suresi, 53. Ayet"
    },
    {
      "metin": "Onlara: \"İşte bu cennet, Allah'a yönelen, O'nun buyruklarına riayet eden; görmediği Rahman'dan korkan, Allah'a yönelmiş bir kalble gelen sizlere, hepinize söz verilen yerdir. Oraya esenlikle girin; işte sonsuzluk günü budur\" denir",
      "kaynak": "Kâf Suresi, 33. Ayet"
    },
    {
      "metin": "Biz gökleri, yeri ve ikisinin arasında bulunanları oyun olsun diye yaratmadık",
      "kaynak": "Duhân Suresi, 38. Ayet"
    },
    {
      "metin": "Doğrusu bu Kuran en doğru yola götürür ve yararlı iş yapan müminlere büyük ecir olduğunu, ahirete inanmayanlara can yakıcı bir azap hazırladığımızı müjdeler",
      "kaynak": "İsrâ Suresi, 9. Ayet"
    },
    {
      "metin": "Onlar, üstlerindeki göğü nasıl yapmışız, süslemişizdir bir bakmazlar mı? Onda hiçbir çatlak da yoktur",
      "kaynak": "Kâf Suresi, 6. Ayet"
    },
    {
      "metin": "Musa'ya kitap verdik. Ey Nuh'la beraber taşıyarak kurtardığımız kimselerin soyundan olanlar! Beni bırakıp başkasını vekil edinmeyesiniz diye onu İsrailoğullarına doğruluk rehberi kıldık. Doğrusu Nuh, çok şükreden bir kuldu",
      "kaynak": "İsrâ Suresi, 3. Ayet"
    },
    {
      "metin": "Yoksa gökleri ve yeri yaratan, gökten size su indirip onunla, bir ağacını bile bitirmeye gücünüzün yetmediği, güzel güzel bahçeler meydana getiren mi? Allah'ın yanında başka bir tanrı mı? Hayır; onlar taptıklarını Allah'a eşit tutan bir millettir",
      "kaynak": "Neml Suresi, 60. Ayet"
    },
    {
