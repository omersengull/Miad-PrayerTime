          >
            <MaterialCommunityIcons name="refresh" size={16} color="#fda4af" />
            <Text style={styles.inlineResetText}>Sıfırla</Text>
          </TouchableOpacity>
        </View>

        {/* Ana Zikir Butonu */}
        <TouchableOpacity
          style={styles.mainButton}
          activeOpacity={0.75}
          onPress={handlePress}
