          setCount(0);
        },
      },
    ],
  );
};

  const turSayisi = Math.floor(count / 33);

  return (
    <View style={styles.container}>
      <Text style={styles.pageTitle}>Zikirmatik</Text>

      {/* Ana Zikirmatik Kutusu */}
