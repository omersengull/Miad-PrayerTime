{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NPM_CONFIG_MINIMUM_RELEASE_AGE": "0",
        "PNPM_CONFIG_MINIMUM_RELEASE_AGE": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.0",
      "pnpm": "10.33.0",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
